   511	func printConsensusUsage(w io.Writer) {
   512		fmt.Fprintln(w, "usage: parley consensus status|draft|signoff|request-signoffs|finalize|reopen")
   513	}
   514	
   515	func runConsensusStatus(args []string, stdout, stderr io.Writer) int {
   516		fs := flag.NewFlagSet("consensus status", flag.ContinueOnError)
   517		fs.SetOutput(stderr)
   518		root := fs.String("dir", ".", "workspace directory")
   519		review := fs.Bool("review", false, "use review consensus")
   520		jsonOut := fs.Bool("json", false, "print unstable JSON output")
   521		if err := fs.Parse(args); err != nil {
   522			return 2
   523		}
   524		if fs.NArg() != 1 {
   525			fmt.Fprintln(stderr, "usage: parley consensus status [--dir DIR] [--review] [--json] IDEA")
   526			return 2
   527		}
   528		summary, err := consensus.Status(*root, fs.Arg(0), *review)
   529		if err != nil {
   530			fmt.Fprintf(stderr, "consensus status failed: %v\n", err)
   531			return 1
   532		}
   533		if *jsonOut {
   534			return printJSON(stdout, summary, stderr)
   535		}
   536		printConsensusSummary(stdout, summary)
   537		return 0
   538	}
   539	
   540	func runConsensusDraft(args []string, stdout, stderr io.Writer) int {
   541		fs := flag.NewFlagSet("consensus draft", flag.ContinueOnError)
   542		fs.SetOutput(stderr)
   543		root := fs.String("dir", ".", "workspace directory")
   544		review := fs.Bool("review", false, "use review consensus")
   545		round := fs.Int("round", 0, "round number to draft from")
   546		by := fs.String("by", "user", "drafting agent ID")
   547		reviewedCommit := fs.String("reviewed-commit", "", "reviewed commit for review consensus")
   548		if err := fs.Parse(args); err != nil {
   549			return 2
   550		}
   551		if fs.NArg() != 1 {
   552			fmt.Fprintln(stderr, "usage: parley consensus draft [--dir DIR] [--review] [--round N] [--by AGENT] IDEA")
   553			return 2
   554		}
   555		summary, err := consensus.Draft(*root, fs.Arg(0), consensus.DraftOptions{
   556			Review:         *review,
   557			Round:          *round,
   558			By:             *by,
   559			ReviewedCommit: *reviewedCommit,
   560		})
   561		if err != nil {
   562			fmt.Fprintf(stderr, "consensus draft failed: %v\n", err)
   563			return 1
   564		}
   565		fmt.Fprintf(stdout, "Drafted consensus at %s\n", summary.Path)
   566		printConsensusSummary(stdout, summary)
   567		return 0
   568	}
   569	
   570	func runConsensusSignoff(args []string, stdout, stderr io.Writer) int {
   571		fs := flag.NewFlagSet("consensus signoff", flag.ContinueOnError)
   572		fs.SetOutput(stderr)
   573		root := fs.String("dir", ".", "workspace directory")
   574		review := fs.Bool("review", false, "use review consensus")
   575		agent := fs.String("agent", "", "participant agent ID")
   576		status := fs.String("status", "", "accept, reserve, reservations, or block")
   577		notes := fs.String("notes", "", "signoff notes")
   578		counter := fs.String("counter", "", "counter-proposal for block signoffs")
   579		if err := fs.Parse(args); err != nil {
   580			return 2
   581		}
   582		if fs.NArg() != 1 || strings.TrimSpace(*agent) == "" || strings.TrimSpace(*status) == "" {
   583			fmt.Fprintln(stderr, "usage: parley consensus signoff [--dir DIR] [--review] --agent ID --status accept|reserve|reservations|block [--notes TEXT] [--counter TEXT] IDEA")
   584			return 2
   585		}
   586		summary, err := consensus.AppendSignoff(*root, fs.Arg(0), consensus.SignoffOptions{
   587			Review:          *review,
   588			Agent:           *agent,
   589			Status:          *status,
   590			Notes:           *notes,
   591			CounterProposal: *counter,
   592		})
   593		if err != nil {
   594			fmt.Fprintf(stderr, "consensus signoff failed: %v\n", err)
   595			return 1
   596		}
   597		fmt.Fprintf(stdout, "Appended signoff for %s to %s\n", *agent, summary.Path)
   598		printConsensusSummary(stdout, summary)
   599		return 0
   600	}
