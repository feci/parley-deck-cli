   339	// setIdeaStatus rewrites the status: field in the idea 00-prompt.md frontmatter
   340	// (the code path the brief found missing — nothing else writes round-02). Atomic.
   341	func setIdeaStatus(ideaDir, status string) error {
   342		path := filepath.Join(ideaDir, "00-prompt.md")
   343		data, err := os.ReadFile(path)
   344		if err != nil {
   345			return err
   346		}
   347		lines := strings.Split(string(data), "\n")
   348		inFrontmatter := false
   349		replaced := false
   350		for i, line := range lines {
   351			trimmed := strings.TrimSpace(line)
   352			if trimmed == "---" {
   353				if !inFrontmatter {
   354					inFrontmatter = true
   355					continue
   356				}
   357				if !replaced {
   358					lines = append(lines[:i], append([]string{"status: " + status}, lines[i:]...)...)
   359					replaced = true
   360				}
   361				break
   362			}
   363			if inFrontmatter && strings.HasPrefix(trimmed, "status:") {
   364				lines[i] = "status: " + status
   365				replaced = true
   366			}
   367		}
   368		if !replaced {
   369			return fmt.Errorf("%s has no frontmatter status field", path)
   370		}
   371		return writeFileAtomic(path, []byte(strings.Join(lines, "\n")), 0o644)
   372	}
   373	
   374	func writeFileAtomic(path string, data []byte, perm os.FileMode) error {
   375		tmp := path + ".tmp"
   376		if err := os.WriteFile(tmp, data, perm); err != nil {
   377			return err
   378		}
   379		return os.Rename(tmp, path)
   380	}
