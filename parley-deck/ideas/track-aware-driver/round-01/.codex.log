   243	// EnsureCentralDefault writes a starter ~/.parley/agents.toml that lists the
   244	// built-in agents with their default model and reasoning, if the file does not
   245	// already exist. It is a no-op when the file is present or home is unresolved.
   246	// Returns the ensured path ("" when skipped).
   247	func EnsureCentralDefault() (string, error) {
   248		path := CentralAgentsPath()
