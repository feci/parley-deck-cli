  2390	// anyRunFailed reports whether round-01 should block auto-drive: no participants,
  2391	// or any non-successful result (mirrors printRunResults' failure verdict without
  2392	// printing, for the TUI auto-drive goroutine).
  2393	func anyRunFailed(results []runner.Result) bool {
  2394		if len(results) == 0 {
  2395			return true
  2396		}
  2397		for _, result := range results {
  2398			if !result.Success() {
  2399				return true
  2400			}
  2401		}
  2402		return false
  2403	}
  2404	
  2405	func printRunResults(stdout io.Writer, results []runner.Result) bool {
  2406		if len(results) == 0 {
  2407			fmt.Fprintln(stdout, "No participants were selected for round-01.")
  2408			return true
  2409		}
  2410	
  2411		failed := false
  2412		for _, result := range results {
  2413			switch {
  2414			case result.Warning != "" && result.ExitError == "":
  2415				fmt.Fprintf(stdout, "  %-8s warning: %s\n", result.AgentID, result.Warning)
  2416			case result.Skipped && result.ExitError == "":
  2417				fmt.Fprintf(stdout, "  %-8s skipped: %s\n", result.AgentID, result.SkipReason)
  2418			case result.ArtifactOK && result.ExitError == "":
  2419				fmt.Fprintf(stdout, "  %-8s wrote %s in %s\n", result.AgentID, result.OutputPath, result.Duration.Round(time.Millisecond))
  2420			default:
  2421				failed = true
  2422				reason := result.ExitError
  2423				if reason == "" {
  2424					reason = "artifact was not created"
  2425				}
  2426				fmt.Fprintf(stdout, "  %-8s failed: %s\n", result.AgentID, reason)
  2427				if result.StdoutPath != "" || result.StderrPath != "" {
  2428					fmt.Fprintf(stdout, "           logs: %s %s\n", result.StdoutPath, result.StderrPath)
  2429				}
  2430			}
  2431		}
  2432		return failed
  2433	}

