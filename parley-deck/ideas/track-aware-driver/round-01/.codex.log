    36	// advanceConsensus runs one tick of the consensus gate (consensus D6/D7). The
    37	// caller has already confirmed the transport/auto gate and that the cursor is in
    38	// PhaseConsensus (consensus.md exists). Returns the (possibly updated) cursor.
    39	func (d *Driver) advanceConsensus(ctx context.Context, c Cursor) (Action, Cursor, error) {
    40		if d.cfg.Consensus == nil {
    41			return ActionSurfaceOnly, c, nil // gate not wired (slice-1 behavior)
    42		}
    43		summary, err := d.cfg.Consensus.Status()
    44		if err != nil {
    45			return ActionEscalated, c, fmt.Errorf("read consensus status: %w", err)
    46		}
    47		switch summary.Triage {
    48		case consensus.TriageReady, consensus.TriageReserved:
    49			finalPath := filepath.Join(d.cfg.IdeaDir, "FINAL.md")
    50			// Validate even if FINAL.md already exists: a stale scaffold from a prior
    51			// failed/partial draft must be re-drafted, never accepted (D7, AF1). The
    52			// idea status is committed to "final" ONLY after the content validates, so a
    53			// failed drafter can never strand the idea at status=final with scaffold
    54			// content.
    55			if finalScaffoldReason(finalPath) != "" {
    56				if err := d.cfg.Consensus.DraftFinal(ctx); err != nil {
    57					return ActionEscalated, c, fmt.Errorf("draft FINAL.md: %w", err)
    58				}
    59				if reason := finalScaffoldReason(finalPath); reason != "" {
    60					return ActionEscalated, c, fmt.Errorf("FINAL.md is not acceptable after drafting: %s", reason)
    61				}
    62			}
    63			if err := setIdeaStatus(d.cfg.IdeaDir, "final"); err != nil {
    64				return ActionEscalated, c, fmt.Errorf("commit idea status final: %w", err)
    65			}
    66			c.Phase = PhaseFinal
    67			c.IdeaStatus = "final"
    68			c.UpdatedAt = nowRFC3339()
    69			if err := d.commitCursor(c, ActionFinalized, PhaseConsensus); err != nil {
    70				return ActionEscalated, c, err
    71			}
    72			return ActionFinalized, c, nil
    73	
    74		case consensus.TriagePartial:
    75			if err := d.cfg.Consensus.RequestSignoffs(ctx, summary.Missing); err != nil {
    76				return ActionEscalated, c, fmt.Errorf("request signoffs: %w", err)
    77			}
    78			// RequestSignoffs is synchronous (it invokes the missing signers and waits).
    79			// If the same participants are still missing, the agents ran but did not
    80			// sign — re-requesting would loop, so escalate for human help instead.
    81			after, err := d.cfg.Consensus.Status()
    82			if err != nil {
    83				return ActionEscalated, c, fmt.Errorf("read consensus status after signoffs: %w", err)
    84			}
    85			if after.Triage == consensus.TriagePartial {
    86				return ActionEscalated, c, fmt.Errorf("signoffs still missing after request: %s", strings.Join(after.Missing, ", "))
    87			}
