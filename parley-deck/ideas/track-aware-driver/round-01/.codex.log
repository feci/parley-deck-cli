  2301	func registerWorkspaceSessions(root string, runs []runstate.RunSummary) {
  2302		sessionStore, err := sessionstore.Default()
  2303		if err != nil {
  2304			return
  2305		}
  2306		now := time.Now().UTC()
  2307		for _, run := range runs {
  2308			if run.RunID == "" || run.Error != "" {
  2309				continue
  2310			}
  2311			createdAt := run.LastEventAt
  2312			if createdAt.IsZero() {
  2313				createdAt = now
  2314			}
