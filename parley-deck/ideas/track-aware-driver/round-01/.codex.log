   271	func (o driverImplOps) DraftReviewConsensus(ctx context.Context, round int) error {
   272		fmt.Fprintf(o.out, "driver: drafting review consensus via %s ...\n", o.drafter)
   273		strict := driver.ReadStrictGate(o.ideaDir)
   274		opts := o.withParticipants(o.drafter)
   275		opts.Round = round
   276		opts.StrictGate = strict // LE-2: emit the close fields under strict_gate
   277		r := runner.RunReviewConsensus(ctx, opts)
   278		if !r.Success() {
   279			return fmt.Errorf("review-consensus drafter %s: %s", r.AgentID, r.ExitError)
   280		}
   281		path := filepath.Join(o.ideaDir, "review", "consensus.md")
   282		if err := runner.ValidateReviewConsensusArtifact(path); err != nil {
   283			return err
   284		}
   285		// Review fix F7: under strict_gate, the drafter MUST emit the close fields. If they
   286		// are absent, fail fast here rather than spinning fresh rounds to MaxFixupCycles.
   287		if strict {
   288			meta, err := protocol.ReadFrontmatter(path)
   289			if err != nil {
   290				return err
   291			}
   292			if strings.TrimSpace(meta["strict_gate_clean"]) == "" || strings.TrimSpace(meta["closing_review_round"]) == "" {
   293				return fmt.Errorf("strict_gate: review/consensus.md must set strict_gate_clean and closing_review_round")
   294			}
   295		}
   296		return nil
   297	}
