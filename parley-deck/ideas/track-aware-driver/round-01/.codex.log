    39	const appName = "parley"
    40	
    41	func Run(args []string, stdout, stderr io.Writer) int {
    42		if len(args) == 0 {
    43			printUsage(stdout)
    44			return 0
    45		}
    46	
    47		ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
    48		defer cancel()
    49	
    50		switch args[0] {
    51		case "help", "-h", "--help":
    52			printUsage(stdout)
    53			return 0
    54		case "--version":
    55			fmt.Fprintln(stdout, versionLine())
    56			return 0
    57		case "version":
    58			return runVersion(ctx, args[1:], stdout, stderr)
    59		case "init":
    60			return runInit(args[1:], stdout, stderr)
    61		case "agents":
    62			return runAgents(ctx, args[1:], stdout, stderr)
    63		case "consensus":
    64			return runConsensus(ctx, args[1:], stdout, stderr)
    65		case "pipeline":
    66			return runPipeline(ctx, args[1:], stdout, stderr)
    67		case "context":
    68			return runContext(args[1:], stdout, stderr)
    69		case "status":
    70			return runStatus(args[1:], stdout, stderr)
    71		case "sessions":
    72			return runSessions(args[1:], stdout, stderr)
    73		case "preflight":
    74			return runPreflight(ctx, args[1:], stdout, stderr)
    75		case "run":
    76			return runTask(ctx, args[1:], stdout, stderr)
    77		case "continue":
    78			return runContinue(ctx, args[1:], stdout, stderr)
    79		case "steer":
    80			return runSteer(args[1:], stdout, stderr)
    81		case "resume":
    82			return runResume(args[1:], stdout, stderr)
    83		case "answer":
    84			return runAnswer(args[1:], stdout, stderr)
    85		case "consult":
    86			return runConsult(ctx, args[1:], stdout, stderr)
    87		case "consults":
    88			return runConsults(args[1:], stdout, stderr)
    89		case "retro":
    90			return runRetro(args[1:], stdout, stderr)
    91		case "loop":
    92			return runLoop(args[1:], stdout, stderr)
    93		case "tui":
    94			return runTUI(ctx, args[1:], stdout, stderr)
    95		default:
    96			fmt.Fprintf(stderr, "unknown command: %s\n\n", args[0])
    97			printUsage(stderr)
    98			return 2
    99		}
   100	}
   101	
   102	func printUsage(w io.Writer) {
   103		fmt.Fprintf(w, `%s orchestrates Parley Deck multi-agent workflows.
   104	
   105	Parley Deck keeps the cooperation trail in a repository-local parley-deck/
   106	directory. The CLI initializes that workspace, discovers local agent CLIs,
   107	starts or resumes multi-agent rounds, tracks HITL questions, manages consensus
   108	signoffs, and emits repository context that can be handed to agents.
   109	
   110	Usage:
   111	  %s init [--dir DIR]
   112	  %s agents list [--dir DIR]
   113	  %s agents verify [--dir DIR] [--agent ID] [--full] [--yes]
   114	  %s consensus status [--dir DIR] [--review] [--json] IDEA
   115	  %s consensus draft [--dir DIR] [--review] [--round N] [--by AGENT] IDEA
   116	  %s consensus signoff [--dir DIR] [--review] --agent ID --status accept|reserve|reservations|block [--notes TEXT] [--counter TEXT] IDEA
   117	  %s consensus request-signoffs [--dir DIR] [--review] [--participants IDS] [--yes] [--dry-run] IDEA
   118	  %s consensus finalize [--dir DIR] [--by AGENT] IDEA
   119	  %s consensus reopen [--dir DIR] [--review] --reason TEXT IDEA
   120	  %s context repo-map [--dir DIR] [--format markdown|json] [--max-files N]
   121	  %s status [--dir DIR] [--run RUN_ID] [--idea SLUG] [--json]
   122	  %s sessions list [--json]
   123	  %s sessions inspect [--dir DIR] [--json] RUN_ID
   124	  %s consult [--dir DIR] [--timeout D] AGENT [QUESTION]
   125	  %s consults list [--dir DIR]
   126	  %s retro <scan|select|diagnose|propose> [--dir DIR] [--k N] [--json] [--slug SLUG]
   127	  %s preflight [--dir DIR] [--json] [--yes] [--ping-timeout D] [--no-ping]
   128	  %s run [--no-tui] [--no-auto] [--no-preflight] [--no-ping] [--participants AGENTS] [--yes] TASK
   129	  %s continue [--dir DIR] [--json] RUN_OR_IDEA
   130	  %s resume [--dir DIR] [--no-tui] RUN_OR_IDEA
   131	  %s answer [--dir DIR] RUN_ID QUESTION_ID ANSWER...
   132	  %s tui [--dir DIR]
   133	  %s loop tick [--dir DIR] [--signals PATH] [--enable] [--json]
   134	  %s help
   135	  %s version [--dir DIR] [--all] [--json]
   136	
   137	Commands:
   138	  init
   139	      Create parley-deck/COOPERATION.md, ideas/, inbox/, meta/, and runs/.
   140	
   141	  agents list
   142	      Print the effective runtime matrix for configured agents: installed
   143	      state, command, launch mode, sandbox/approval policy, model/profile,
   144	      timeout, home isolation, backend class, and config sources.
   145	
   146	  agents verify
   147	      Check configured agent CLIs. By default this is a cheap version probe.
   148	      Use --full --yes to run behavioral probes that may call hosted backends.
   149	
   150	  preflight
   151	      Readiness check before an idea: protocol freshness (advisory in a source
   152	      repo; additive consumer auto-sync preserving project zones; breaking bump
   153	      gated) plus a hosted-PONG roster liveness ping. Exit 0 ready, 3 pending
   154	      gate (names the gate + confirm command), 1 hard failure (no workspace, or
   155	      excluding unavailable agents would leave <2 participants), 2 usage.
   156	
   157	  run
   158	      Create a new idea from TASK and start round-01 with selected agents.
   159	      Auto-drive is ON by default: after round-01 the protocol advances
   160	      automatically (cross-review, consensus, finalize, and — if the idea opts
   161	      into auto_implement — the implementation/fix-up phases), shown live in the
   162	      TUI. Pass --no-auto to stop after round-01 and advance manually; with
   163	      --no-auto and without --yes, Parley asks before launching hosted agents.
   164	
   165	  resume
   166	      Re-open a run by run ID or idea slug, validate pending handoffs, and
   167	      continue the live TUI unless --no-tui is set.
   168	
   169	  continue
   170	      Inspect a run by run ID or idea slug and print planner-derived next
   171	      actions for continuing the workflow. This first slice is read-only; use
   172	      the printed commands for existing safe actions such as answering HITL
   173	      questions or consensus operations.
   174	
   175	  pipeline
   176	      Compose the cooperation engine into §12 pipeline blocks via a
   177	      pipeline.yaml manifest. Subcommands: validate MANIFEST, start MANIFEST,
   178	      status SLUG, continue SLUG, gate approve|reject SLUG EDGE. Supervised-first:
   179	      block boundaries gate by default; production mutations are non-bypassable.
   180	
   181	  status
   182	      Show workspace, idea, consensus, run, and HITL question state.
   183	
   184	  sessions
   185	      List and inspect the local Parley session index in ~/.parley-deck.
   186	      Inspect resolves the stored workspace run and prints manifest details
   187	      when parley-deck/runs/<run-id>/run.json exists.
   188	      Use --dir to disambiguate or inspect an unindexed run from a workspace.
   189	      Slice 1 is read-only and assumes a single active parley process per run.
   190	
   191	  answer
   192	      Answer a pending human-in-the-loop question for a run.
   193	
   194	  consensus
   195	      Draft, inspect, sign, request signoffs for, finalize, or reopen design
   196	      and review consensus files under parley-deck/ideas/<idea>/.
   197	
   198	  context repo-map
   199	      Emit a deterministic local repository map for agent context. Markdown is
   200	      optimized for humans and prompts; JSON is optimized for tooling.
   201	
   202	  tui
   203	      Open the project TUI for workspace status, run state, questions, and
   204	      agent/runtime inspection.
   205	
   206	  version
   207	      Print the CLI version. With --all, also print parley-deck-skill and
   208	      project metadata compatibility status when available.
   209	
   210	Parameters and flags:
   211	  --dir DIR
   212	      Workspace root. Defaults to the current directory.
   213	
   214	  --participants AGENTS
   215	      Comma-separated agent IDs, for example claude,agy,hermes.
   216	
   217	  --yes
   218	      Confirm an operation that may launch configured hosted backends.
   219	
   220	  --auto
   221	      Enable automatic low-risk HITL handling during a run.
   222	
   223	  --no-tui
   224	      Run or resume without opening the live terminal UI.
   225	
   226	  --json
   227	      Print machine-readable JSON for commands that support it.
   228	
   229	  --review
   230	      Target review consensus at review/consensus.md instead of consensus.md.
   231	
   232	  --agent ID
   233	      Select one participant or signer by stable Parley agent ID.
   234	
   235	  --status VALUE
   236	      Signoff status: accept, reserve, reservations, or block.
   237	
   238	  --notes TEXT
   239	      Notes appended to a signoff.
   240	
   241	  --counter TEXT
   242	      Counter-proposal required for block signoffs.
   243	
   244	  --round N
   245	      Round number used when drafting consensus.
   246	
   247	  --by AGENT
   248	      Agent ID recorded as drafter/finalizer.
   249	
   250	  --format markdown|json
   251	      Output format for context repo-map. Defaults to markdown.
   252	
   253	  --max-files N
   254	      Maximum number of files in repo-map output. Defaults to 1000.
   255	
   256	  TASK
   257	      Free-form work request used to create a new idea.
   258	
   259	  IDEA / SLUG
   260	      Idea directory name under parley-deck/ideas/.
   261	
   262	  RUN_ID
   263	      Run directory ID under parley-deck/runs/.
   264	
   265	  QUESTION_ID
   266	      HITL question ID from a run's questions directory.
   267	
   268	Examples:
   269	  # Initialize a repository for Parley Deck.
   270	  %s init --dir .
   271	
   272	  # Inspect configured agents and runtime defaults.
   273	  %s agents list --dir .
   274	  %s agents verify --dir . --agent claude
   275	
   276	  # Generate agent-friendly repository context.
   277	  %s context repo-map --dir . --format markdown --max-files 50
   278	  %s context repo-map --dir . --format json --max-files 10
   279	
   280	  # Start a headless round with selected agents.
   281	  %s run --dir . --no-tui --participants claude,agy --yes "Plan the next CLI slice"
   282	
   283	  # Resume or inspect active work.
   284	  %s status --dir .
   285	  %s status --dir . --idea repo-map-mvp
   286	  %s sessions list
   287	  %s sessions inspect 20260517T120000.000000000Z
   288	  %s continue --dir . 20260517T120000.000000000Z
   289	  %s resume --dir . 20260517T120000.000000000Z
   290	
   291	  # Consensus flow.
   292	  %s consensus status --dir . repo-map-mvp
   293	  %s consensus draft --dir . --round 1 --by codex repo-map-mvp
   294	  %s consensus request-signoffs --dir . --participants claude,agy --yes repo-map-mvp
   295	
   296	  # Answer a HITL question.
   297	  %s answer --dir . 20260517T120000.000000000Z q1 "Use the conservative default"
   298	
   299	  # Version and compatibility status.
   300	  %s version
   301	  %s version --all
   302	
   303	Exit codes:
   304	  0  Success.
   305	  1  Runtime failure, failed probe, malformed workspace, or agent failure.
   306	  2  Usage error or missing required argument.
   307	  3  Pending manual/interactive handoff for consensus request-signoffs.
   308	
   309	`, appName,
   310			appName,
   311			appName,
   312			appName,
   313			appName,
