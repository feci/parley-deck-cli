    20	// RunReviewConsensus + the review-mode consensus package.
    21	type ImplOps interface {
    22		Implement(ctx context.Context) error                       // Phase 5: one implementer → IMPLEMENTATION.md + code
    23		ImplementationStatus() (string, error)                     // IMPLEMENTATION.md status: frontmatter
    24		RunChecks(ctx context.Context) (bool, string)              // build/test gate; (ok, detail)
    25		OpenReviewRound(ctx context.Context, round int) error      // Phase 6: non-implementer reviewers
    26		ReviewRoundComplete(round int) (bool, error)               // all reviewer artifacts present + valid
    27		DraftReviewConsensus(ctx context.Context, round int) error // Phase 7: draft review/consensus.md
    28		ReviewStatus() (ReviewStatus, error)                       // review-mode triage + outstanding_agreed_fixes
    29		RequestReviewSignoffs(ctx context.Context, missing []string) error
    30		Fixup(ctx context.Context, cycle int) error // Phase 8: re-invoke implementer for agreed fixes
    31		Complete(ctx context.Context) error         // driver writes IMPLEMENTATION.md status=complete
    32		// GoalCheck (LE-7) runs a fresh non-implementer agent to check FINAL.md observable
    33		// acceptance criteria before close. Returns (false, detail) only on a confident FAIL;
    34		// a checker error/ambiguous verdict returns (true, advisory) — fail-open, since this
    35		// is defense-in-depth on top of an already-passed review consensus, not the sole gate.
    36		GoalCheck(ctx context.Context) (bool, string)
    37	}
    38	
    39	// ReviewStatus wraps the review-mode consensus summary plus the machine-readable
    40	// Phase-7 fields the unattended loop decides on (consensus D5).
    41	type ReviewStatus struct {
    42		Summary                consensus.Summary
    43		OutstandingAgreedFixes int
    44		Blocked                bool
    45		// StrictGateClean + ClosingReviewRound carry the drafter's strict_gate
    46		// certification (LE-2): the drafter sets strict_gate_clean true only when the
    47		// round it names in closing_review_round had zero findings of any severity.
    48		StrictGateClean    bool
    49		ClosingReviewRound int
    50		// ReviewerCount is the number of independent (non-implementer) reviewers (LE-11):
    51		// the auto-driver refuses to auto-complete a code-writing idea with fewer than 2.
    52		ReviewerCount int
    53	}
    54	
    55	const (
    56		ActionImplemented   Action = "implemented"    // ran the implementer → PhaseImpl
    57		ActionReviewOpened  Action = "review-opened"  // opened a review round → PhaseReview
    58		ActionReviewDrafted Action = "review-drafted" // drafted review/consensus.md
    59		ActionFixup         Action = "fixup"          // ran a fix-up cycle → new review round
    60		ActionComplete      Action = "complete"       // review clean → status=complete → PhaseDone
    61	)
    62	
    63	// advanceFinal decides whether to auto-implement after FINAL.md (consensus D3/D6).
    64	func (d *Driver) advanceFinal(ctx context.Context, c Cursor) (Action, Cursor, error) {
    65		if d.cfg.Impl == nil {
    66			return ActionSurfaceOnly, c, nil // impl auto-drive not wired (slice 1-2 behavior)
    67		}
    68		if fileExists(filepath.Join(d.cfg.IdeaDir, "IMPLEMENTATION.md")) {
    69			return ActionSurfaceOnly, c, nil // Rebuild moves to PhaseImpl/Review next tick
    70		}
    71		if !d.cfg.AutoImplement {
    72			return ActionSurfaceOnly, c, nil // idea did not opt in / --no-implement → stop at FINAL
    73		}
    74		if !gitTreeClean(d.cfg.Root) {
    75			return ActionEscalated, c, fmt.Errorf("git working tree is dirty; refusing to run the implementer (commit or stash first)")
    76		}
    77		if err := d.cfg.Impl.Implement(ctx); err != nil {
    78			return ActionEscalated, c, fmt.Errorf("implement: %w", err)
    79		}
    80		c.Phase = PhaseImpl
    81		c.IdeaStatus = "implemented"
    82		c.UpdatedAt = nowRFC3339()
    83		if err := d.commitCursor(c, ActionImplemented, PhaseFinal); err != nil {
    84			return ActionEscalated, c, err
    85		}
    86		return ActionImplemented, c, nil
    87	}
    88	
    89	// advanceImpl validates the implementation, runs the checks gate, and opens the
    90	// first review round (consensus D6).
    91	func (d *Driver) advanceImpl(ctx context.Context, c Cursor) (Action, Cursor, error) {
    92		if d.cfg.Impl == nil {
    93			return ActionSurfaceOnly, c, nil
    94		}
    95		status, err := d.cfg.Impl.ImplementationStatus()
    96		if err != nil {
    97			return ActionEscalated, c, fmt.Errorf("read implementation status: %w", err)
    98		}
    99		if !implReadyForReview(status) {
   100			// A known in-progress status means the implementation attempt is mid-flight
   101			// (e.g. a crash/re-entry); await rather than fail. An empty/unknown status is
   102			// fail-closed (AF7/D6).
   103			if implInProgress(status) {
   104				return ActionAwait, c, nil
   105			}
   106			return ActionEscalated, c, fmt.Errorf("IMPLEMENTATION.md status=%q is neither review-ready nor a known in-progress state", status)
   107		}
   108		// Build/test gate before spending reviewer agents (D4); failure escalates.
   109		if ok, detail := d.cfg.Impl.RunChecks(ctx); !ok {
   110			return ActionEscalated, c, fmt.Errorf("checks failed before review:\n%s", strings.TrimSpace(detail))
   111		}
   112		// PhaseImpl only opens the FIRST review round; subsequent rounds come from the
   113		// fix-up loop in advanceReview. Re-entry is safe: once review/round-01 exists,
   114		// Rebuild routes to PhaseReview instead.
   115		if err := d.cfg.Impl.OpenReviewRound(ctx, 1); err != nil {
   116			return ActionEscalated, c, fmt.Errorf("open review round 1: %w", err)
   117		}
   118		c.Phase = PhaseReview
   119		c.UpdatedAt = nowRFC3339()
   120		if err := d.commitCursor(c, ActionReviewOpened, PhaseImpl); err != nil {
   121			return ActionEscalated, c, err
   122		}
   123		return ActionReviewOpened, c, nil
   124	}
   125	
   126	// advanceReview runs the Phase 6-8 loop: complete the round → draft review
   127	// consensus → signoffs → done | fix-up | escalate (consensus D5/D6).
   128	func (d *Driver) advanceReview(ctx context.Context, c Cursor) (Action, Cursor, error) {
   129		if d.cfg.Impl == nil {
   130			return ActionSurfaceOnly, c, nil
   131		}
   132		round := highestReviewRound(d.cfg.IdeaDir)
   133		if round < 1 {
   134			round = 1
   135		}
   136		// AF2 crash-idempotency: if this round's fix-up already completed (a crash after
   137		// Fixup+RunChecks but before the next round opened), finish the transition
   138		// without re-running Fixup or re-drafting the consensus.
   139		fixupMarker := filepath.Join(d.cfg.IdeaDir, "review", roundLabel(round), ".fixup-done")
   140		if fileExists(fixupMarker) {
   141			if err := d.archiveReviewConsensus(round); err != nil {
   142				return ActionEscalated, c, fmt.Errorf("archive review consensus: %w", err)
   143			}
   144			if err := d.cfg.Impl.OpenReviewRound(ctx, round+1); err != nil {
   145				return ActionEscalated, c, fmt.Errorf("open review round %d: %w", round+1, err)
   146			}
   147			c.Phase = PhaseReview
   148			c.UpdatedAt = nowRFC3339()
   149			if err := d.commitCursor(c, ActionFixup, PhaseReview); err != nil {
   150				return ActionEscalated, c, err
   151			}
   152			return ActionFixup, c, nil
   153		}
   154		complete, err := d.cfg.Impl.ReviewRoundComplete(round)
   155		if err != nil {
   156			return ActionEscalated, c, fmt.Errorf("check review round %d: %w", round, err)
   157		}
   158		if !complete {
   159			// Fill any missing reviewer artifacts (RunReviewRound is Overwrite=false), then
   160			// await; the loop deadline bounds a reviewer that never finishes.
   161			if err := d.cfg.Impl.OpenReviewRound(ctx, round); err != nil {
   162				return ActionEscalated, c, fmt.Errorf("re-open review round %d: %w", round, err)
   163			}
   164			if done, _ := d.cfg.Impl.ReviewRoundComplete(round); !done {
   165				return ActionAwait, c, nil
   166			}
   167		}
   168	
   169		reviewConsensus := filepath.Join(d.cfg.IdeaDir, "review", "consensus.md")
   170		if !fileExists(reviewConsensus) {
   171			if err := d.cfg.Impl.DraftReviewConsensus(ctx, round); err != nil {
   172				return ActionEscalated, c, fmt.Errorf("draft review consensus: %w", err)
   173			}
   174			return ActionReviewDrafted, c, nil
   175		}
   176	
   177		rs, err := d.cfg.Impl.ReviewStatus()
   178		if err != nil {
   179			return ActionEscalated, c, fmt.Errorf("read review status: %w", err) // malformed → escalate
   180		}
   181		if rs.Blocked {
   182			return ActionEscalated, c, fmt.Errorf("review consensus is blocked; escalating")
   183		}
   184		if len(rs.Summary.Missing) > 0 {
   185			if err := d.cfg.Impl.RequestReviewSignoffs(ctx, rs.Summary.Missing); err != nil {
   186				return ActionEscalated, c, fmt.Errorf("request review signoffs: %w", err)
   187			}
   188			after, err := d.cfg.Impl.ReviewStatus()
   189			if err != nil {
   190				return ActionEscalated, c, fmt.Errorf("read review status after signoffs: %w", err)
   191			}
   192			if len(after.Summary.Missing) > 0 {
   193				return ActionEscalated, c, fmt.Errorf("review signoffs still missing: %s", strings.Join(after.Summary.Missing, ", "))
   194			}
   195			rs = after
   196		}
   197		if rs.Summary.Triage != consensus.TriageReady && rs.Summary.Triage != consensus.TriageReserved {
   198			return ActionEscalated, c, fmt.Errorf("review consensus triage=%q; cannot complete", rs.Summary.Triage)
   199		}
   200	
   201		if rs.OutstandingAgreedFixes == 0 {
   202			if d.cfg.StrictGate {
   203				// strict_gate (LE-2): completion requires a FRESH full-scope closing review
   204				// round with zero findings of any severity — certified by the drafter
   205				// (strict_gate_clean + closing_review_round for THIS round) and not
   206				// contradicted by a deterministic finding scan. The scan can only veto a
   207				// clean claim (fail closed); it never auto-passes one.
   208				certifiedClean := rs.StrictGateClean && rs.ClosingReviewRound == round
   209				if certifiedClean && reviewRoundHasFindings(d.cfg.IdeaDir, round) {
   210					return ActionEscalated, c, fmt.Errorf("strict_gate: drafter certified round %d clean but a review file has a real finding; escalating", round)
   211				}
   212				if !certifiedClean {
   213					// Not a certified-clean closing round yet → run one more fresh review
   214					// round. Bounded by MaxFixupCycles so the strict-close loop terminates.
   215					if round >= d.cfg.MaxFixupCycles {
   216						return ActionEscalated, c, fmt.Errorf("strict_gate: no clean closing review round after %d round(s) (MaxFixupCycles=%d); escalating", round, d.cfg.MaxFixupCycles)
   217					}
   218					if err := d.archiveReviewConsensus(round); err != nil {
   219						return ActionEscalated, c, fmt.Errorf("archive review consensus: %w", err)
   220					}
   221					if err := d.cfg.Impl.OpenReviewRound(ctx, round+1); err != nil {
   222						return ActionEscalated, c, fmt.Errorf("open strict closing review round %d: %w", round+1, err)
   223					}
   224					c.Phase = PhaseReview
   225					c.UpdatedAt = nowRFC3339()
   226					if err := d.commitCursor(c, ActionReviewOpened, PhaseReview); err != nil {
   227						return ActionEscalated, c, err
   228					}
   229					return ActionReviewOpened, c, nil
   230				}
   231			}
   232			// LE-11 (HITL-fatigue guardrails): under auto-drive, do not silently auto-complete
   233			// on a soft "reservations" triage or with a single checker — both re-create a quiet
   234			// false-green a fatigued human waves through. Surface to a human instead. A
   235			// design-only (non-auto_implement) idea keeps the lighter close (conditional rigor).
   236			if d.cfg.AutoImplement {
   237				if rs.Summary.Triage == consensus.TriageReserved {
   238					return ActionEscalated, c, fmt.Errorf("review consensus is ACCEPT-WITH-RESERVATIONS; under auto_implement, reservations need human review before completion (LE-11)")
   239				}
   240				if rs.ReviewerCount < 2 {
   241					return ActionEscalated, c, fmt.Errorf("only %d independent reviewer(s); auto-complete requires at least 2 (LE-11) — add a reviewer or sign off manually", rs.ReviewerCount)
   242				}
   243			}
   244			// LE-7 (goal-done gate): before completing an auto-driven / strict idea, a fresh
   245			// non-implementer agent checks the FINAL.md acceptance criteria. A confident FAIL
   246			// escalates; a checker error is advisory (fail-open inside GoalCheck).
   247			if d.cfg.AutoImplement || d.cfg.StrictGate {
   248				if ok, detail := d.cfg.Impl.GoalCheck(ctx); !ok {
   249					return ActionEscalated, c, fmt.Errorf("goal-done gate: the acceptance-criteria check did not pass (LE-7):\n%s", strings.TrimSpace(detail))
   250				}
   251			}
   252			// DONE (D5): the driver — not the implementer — writes status=complete.
   253			if err := d.cfg.Impl.Complete(ctx); err != nil {
   254				return ActionEscalated, c, fmt.Errorf("mark complete: %w", err)
   255			}
   256			c.Phase = PhaseDone
   257			c.IdeaStatus = "complete"
   258			c.UpdatedAt = nowRFC3339()
   259			if err := d.commitCursor(c, ActionComplete, PhaseReview); err != nil {
   260				return ActionEscalated, c, err
   261			}
   262			return ActionComplete, c, nil
   263		}
   264	
   265		// Outstanding agreed fixes → a fix-up cycle, bounded by MaxFixupCycles.
   266		cycle := round
   267		if cycle >= d.cfg.MaxFixupCycles {
   268			return ActionEscalated, c, fmt.Errorf("review still has %d agreed fixes after %d cycle(s) (MaxFixupCycles=%d); escalating", rs.OutstandingAgreedFixes, cycle, d.cfg.MaxFixupCycles)
   269		}
   270		if !d.cfg.AutoImplement {
   271			return ActionEscalated, c, fmt.Errorf("review has agreed fixes but auto_implement (code-writing) is not enabled; escalating")
   272		}
   273		if !gitTreeClean(d.cfg.Root) {
   274			return ActionEscalated, c, fmt.Errorf("git working tree is dirty; refusing to run a fix-up")
   275		}
   276		if err := d.cfg.Impl.Fixup(ctx, cycle); err != nil {
   277			return ActionEscalated, c, fmt.Errorf("fix-up cycle %d: %w", cycle, err)
   278		}
   279		// AF1: re-run the build/test gate after the fix-up, before spending reviewers on
   280		// the next round; a fix-up that broke the build escalates immediately.
   281		if ok, detail := d.cfg.Impl.RunChecks(ctx); !ok {
   282			return ActionEscalated, c, fmt.Errorf("checks failed after fix-up cycle %d before review:\n%s", cycle, strings.TrimSpace(detail))
   283		}
   284		// AF2: mark the fix-up done so a crash before the next round opens does not
   285		// re-run Fixup on re-entry.
   286		if err := os.WriteFile(fixupMarker, []byte(nowRFC3339()+"\n"), 0o644); err != nil {
   287			return ActionEscalated, c, fmt.Errorf("write fix-up marker: %w", err)
   288		}
   289		// Archive the just-reviewed consensus and open the next review round so the next
   290		// tick drafts a fresh consensus for round N+1 (consensus D8 + agy's archiving).
   291		if err := d.archiveReviewConsensus(round); err != nil {
   292			return ActionEscalated, c, fmt.Errorf("archive review consensus: %w", err)
   293		}
   294		if err := d.cfg.Impl.OpenReviewRound(ctx, round+1); err != nil {
   295			return ActionEscalated, c, fmt.Errorf("open review round %d: %w", round+1, err)
   296		}
   297		c.Phase = PhaseReview
   298		c.UpdatedAt = nowRFC3339()
   299		if err := d.commitCursor(c, ActionFixup, PhaseReview); err != nil {
   300			return ActionEscalated, c, err
   301		}
   302		return ActionFixup, c, nil
   303	}
   304	
   305	// archiveReviewConsensus moves the active review/consensus.md to
   306	// review/round-NN/consensus.md before the next cycle re-drafts the root file,
   307	// preserving a per-cycle audit trail (and clearing the root so the gate re-drafts).
   308	func (d *Driver) archiveReviewConsensus(round int) error {
   309		src := filepath.Join(d.cfg.IdeaDir, "review", "consensus.md")
   310		if !fileExists(src) {
   311			return nil
   312		}
   313		dst := filepath.Join(d.cfg.IdeaDir, "review", roundLabel(round), "consensus.md")
   314		if err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {
   315			return err
   316		}
   317		if fileExists(dst) {
   318			if err := os.Remove(dst); err != nil {
   319				return err
   320			}
   321		}
   322		return os.Rename(src, dst)
   323	}
   324	
   325	func implReadyForReview(status string) bool {
   326		switch {
   327		case status == "implemented", status == "ready-for-review":
   328			return true
   329		case strings.HasPrefix(status, "fix-up-cycle"):
   330			return true
   331		}
   332		return false
   333	}
   334	
   335	// reviewRoundHasFindings scans a review round's reviewer files for at least one real
   336	// finding — a "### [CRITICAL|MAJOR|MINOR|NIT] <title>" heading whose title is non-empty
   337	// and not the literal "<title>" placeholder from the prompt template. It is a
   338	// deterministic veto on a strict_gate_clean claim (LE-2): it can only fail a clean
   339	// claim closed, never auto-pass one.
   340	func reviewRoundHasFindings(ideaDir string, round int) bool {
   341		dir := filepath.Join(ideaDir, "review", roundLabel(round))
   342		entries, err := os.ReadDir(dir)
   343		if err != nil {
   344			// Fail closed (review fix F1): an absent dir means nothing to veto
   345			// (ReviewRoundComplete guards presence). But an unreadable dir that should
   346			// exist must VETO (return true → escalate), never silently auto-pass — the
   347			// scan's stated invariant is "veto-only, never auto-pass."
   348			return !errors.Is(err, fs.ErrNotExist)
   349		}
   350		for _, e := range entries {
   351			name := e.Name()
   352			if e.IsDir() || !strings.HasSuffix(name, ".md") || name == "_index.md" || name == "consensus.md" {
   353				continue
   354			}
   355			data, err := os.ReadFile(filepath.Join(dir, name))
   356			if err != nil {
   357				return true // F1: a file confirmed present but now unreadable → fail closed (veto)
   358			}
   359			if scanHasRealFinding(string(data)) {
   360				return true
   361			}
   362		}
   363		return false
   364	}
   365	
   366	// scanHasRealFinding reports whether the content has a severity-tagged finding heading.
   367	// It is whitespace-tolerant and case-insensitive on the severity tag (review fix F2),
   368	// tolerates any markdown heading level ##..###### (review fix F10), counts an empty-title
   369	// heading as a finding (review fix F3), and counts even a literal "<title>" placeholder
   370	// heading when real finding content follows it (review fix F9). Only a bare placeholder
   371	// heading with no content below is ignored.
   372	//
   373	// Scope note: the scan targets the protocol-prescribed heading format. Findings written in
   374	// off-spec shapes (bold, bullet lists, prose) are out of this backstop's scope by design —
   375	// they are caught by the reviewers' severity discipline and the drafter's certification,
   376	// not by this deterministic veto.
   377	func scanHasRealFinding(content string) bool {
   378		lines := strings.Split(content, "\n")
   379		for i, line := range lines {
   380			t := strings.TrimSpace(line)
   381			hashes := 0
   382			for hashes < len(t) && t[hashes] == '#' {
   383				hashes++
   384			}
   385			if hashes < 2 { // F10: ##, ###, #### … count; non-headings do not
   386				continue
   387			}
   388			rest := strings.TrimSpace(t[hashes:])
   389			if !strings.HasPrefix(rest, "[") {
   390				continue
   391			}
   392			closeIdx := strings.Index(rest, "]")
   393			if closeIdx < 0 {
   394				continue
   395			}
   396			switch strings.ToUpper(strings.TrimSpace(rest[1:closeIdx])) {
   397			case "CRITICAL", "MAJOR", "MINOR", "NIT":
   398			default:
   399				continue
   400			}
   401			if strings.TrimSpace(rest[closeIdx+1:]) != "<title>" {
   402				return true // concrete or empty title (F3) both count
   403			}
   404			if headingHasContent(lines[i+1:]) { // F9: placeholder title but real content below
   405				return true
   406			}
   407		}
   408		return false
   409	}
   410	
   411	// headingHasContent reports whether the lines under a heading (up to the next heading)
   412	// contain a non-blank line that is not itself an angle-bracket "<...>" template placeholder.
   413	func headingHasContent(after []string) bool {
   414		for _, line := range after {
   415			t := strings.TrimSpace(line)
   416			if t == "" {
   417				continue
   418			}
   419			if strings.HasPrefix(t, "#") {
   420				return false // reached the next heading without finding content
   421			}
   422			if strings.HasPrefix(t, "<") && strings.HasSuffix(t, ">") {
   423				continue // template body placeholder, e.g. "<what is wrong, …>"
   424			}
   425			return true
   426		}
   427		return false
   428	}
   429	
   430	func implInProgress(status string) bool {
   431		switch strings.ToLower(strings.TrimSpace(status)) {
   432		case "in-progress", "in_progress", "wip", "draft", "drafting":
   433			return true
   434		}
   435		return false
   436	}
   437	
   438	// gitTreeClean reports whether the workspace git tree has no uncommitted changes.
   439	// A non-git workspace (or missing git) is treated as clean — there is nothing to
   440	// clobber. But INSIDE a real repo, a git error (e.g. a stale index.lock) is treated
   441	// as dirty/unsafe rather than clean, so we never run a code-writing agent on a
   442	// possibly-dirty tree (consensus D3/AF9).
   443	func gitTreeClean(root string) bool {
   444		// GIT_OPTIONAL_LOCKS=0: read-only probes must never take optional locks
   445		// (index refresh writes .git) on the weakly-coherent virtio-fs mount
   446		// (runner-hardening-kindly D8).
   447		probe := func(args ...string) *exec.Cmd {
   448			cmd := exec.Command("git", args...)
   449			cmd.Env = append(os.Environ(), "GIT_OPTIONAL_LOCKS=0")
   450			return cmd
   451		}
   452		if err := probe("-C", root, "rev-parse", "--is-inside-work-tree").Run(); err != nil {
   453			return true // not inside a git work tree (or git missing) → nothing to clobber
   454		}
   455		out, err := probe("-C", root, "status", "--porcelain").Output()
   456		if err != nil {
   457			return false // inside a repo but the status probe failed → assume unsafe
   458		}
   459		return strings.TrimSpace(string(out)) == ""
   460	}

