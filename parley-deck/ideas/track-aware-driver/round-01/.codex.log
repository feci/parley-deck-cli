   292			if errors.Is(err, os.ErrNotExist) {
   293				return "", nil
   294			}
   295			return "", fmt.Errorf("read event log: %w", err)
   296		}
   297		terminal := ""
   298		for _, e := range events {
   299			if e.Type != "round.completed" && e.Type != "round.incomplete" {
   300				continue
   301			}
   302			if r, _ := e.Data["round"].(string); r != label {
   303				continue
   304			}
   305			// D4: the terminal event is scoped to idea+round. Tolerate a missing idea
   306			// field (older events) but reject a mismatching one.
   307			if idea, _ := e.Data["idea"].(string); idea != "" && idea != d.cfg.IdeaSlug {
