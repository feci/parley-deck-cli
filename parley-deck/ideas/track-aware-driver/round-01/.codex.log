   439	// Complete writes IMPLEMENTATION.md status=complete. This is a deterministic file
   440	// write by the orchestrator (NOT an implementer agent), so an implementer cannot
   441	// short-circuit review (consensus D5).
   442	func (o driverImplOps) Complete(ctx context.Context) error {
   443		path := filepath.Join(o.ideaDir, "IMPLEMENTATION.md")
   444		data, err := os.ReadFile(path)
   445		if err != nil {
   446			return err
   447		}
   448		lines := strings.Split(string(data), "\n")
   449		inFrontmatter := false
   450		replaced := false
   451		for i, line := range lines {
   452			trimmed := strings.TrimSpace(line)
   453			if trimmed == "---" {
   454				if !inFrontmatter {
   455					inFrontmatter = true
   456					continue
   457				}
   458				if !replaced {
   459					lines = append(lines[:i], append([]string{"status: complete"}, lines[i:]...)...)
   460					replaced = true
   461				}
   462				break
   463			}
   464			if inFrontmatter && strings.HasPrefix(trimmed, "status:") {
   465				lines[i] = "status: complete"
   466				replaced = true
   467			}
   468		}
   469		if !replaced {
   470			return fmt.Errorf("%s has no frontmatter status field", path)
   471		}
   472		tmp := path + ".tmp"
   473		if err := os.WriteFile(tmp, []byte(strings.Join(lines, "\n")), 0o644); err != nil {
   474			return err
   475		}
   476		return os.Rename(tmp, path)
   477	}
