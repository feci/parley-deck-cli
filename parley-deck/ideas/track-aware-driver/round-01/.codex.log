   128	func StartAutoAnswerer(ctx context.Context, runDir string) {
   129		go func() {
   130			ticker := time.NewTicker(250 * time.Millisecond)
   131			defer ticker.Stop()
   132			for {
   133				select {
   134				case <-ctx.Done():
   135					return
   136				case <-ticker.C:
   137					_, _ = hitl.New(runDir).AutoAnswerOpen()
   138				}
   139			}
   140		}()
   141	}
