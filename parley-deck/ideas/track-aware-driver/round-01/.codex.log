   154	// finalScaffoldReason returns a non-empty reason when FINAL.md is still a scaffold
   155	// or otherwise unacceptable (consensus D7), or "" when it is acceptable content.
   156	func finalScaffoldReason(path string) string {
   157		data, err := os.ReadFile(path)
   158		if err != nil {
   159			return "FINAL.md is missing"
   160		}
   161		if len(data) <= 250 {
   162			return "FINAL.md is shorter than 250 bytes (scaffold)"
   163		}
   164		if status, _ := readFrontmatterField(path, "status"); status != "final" {
   165			return fmt.Sprintf("FINAL.md frontmatter status=%q, want final", status)
   166		}
   167		body := string(data)
   168		const section = "## Final plan / specification"
   169		idx := strings.Index(body, section)
   170		if idx < 0 {
   171			return "FINAL.md missing '## Final plan / specification' section"
   172		}
   173		rest := body[idx+len(section):]
   174		if next := strings.Index(rest, "\n## "); next >= 0 {
   175			rest = rest[:next]
   176		}
   177		content := 0
   178		for _, line := range strings.Split(rest, "\n") {
   179			trimmed := strings.TrimSpace(line)
   180			if trimmed == "" || strings.HasPrefix(trimmed, "<!--") {
   181				continue
   182			}
   183			// Reject only actual unexpanded TEMPLATE placeholders, not legitimate
   184			// angle-bracket content (e.g. a help-text example `'<option>'` or a path
   185			// `<path>` that is part of the subject matter). Match the scaffold's tokens
   186			// and ellipsis placeholders.
   187			lower := strings.ToLower(trimmed)
   188			for _, ph := range []string{"<...>", "<…>", "<slug>", "<agent-id>", "<agent>", "<fill", "<todo", "<tbd", "<your ", "<replace", "<insert"} {
   189				if strings.Contains(lower, ph) {
   190					return "FINAL.md '## Final plan / specification' still contains an unexpanded placeholder " + ph
   191				}
   192			}
   193			content++
   194		}
   195		if content < 3 {
   196			return "FINAL.md '## Final plan / specification' has fewer than 3 content lines (scaffold)"
   197		}
   198		return ""
   199	}

