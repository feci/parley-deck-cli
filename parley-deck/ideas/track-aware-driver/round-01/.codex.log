   356	func runInit(args []string, stdout, stderr io.Writer) int {
   357		fs := flag.NewFlagSet("init", flag.ContinueOnError)
   358		fs.SetOutput(stderr)
   359		root := fs.String("dir", ".", "workspace directory")
   360		if err := fs.Parse(args); err != nil {
   361			return 2
   362		}
   363	
   364		// Seed the user-global central default (~/.parley/agents.toml) FIRST so its
   365		// [defaults].preferred_transport can seed this fresh deck's transport, and so
   366		// every project inherits the same roster + model + reasoning unless it
   367		// overrides them in parley-deck/agents.toml. Non-fatal.
   368		centralPath, centralErr := config.EnsureCentralDefault()
   369		if centralErr != nil {
   370			fmt.Fprintf(stderr, "warning: could not write central default %s: %v\n", config.CentralAgentsPath(), centralErr)
   371		}
   372	
   373		// Honor the central [defaults].preferred_transport for the fresh deck (the
   374		// project deck doesn't exist yet, so this comes from ~/.parley/agents.toml).
   375		transport := ""
   376		if defs, err := config.LoadDefaults(*root); err == nil {
   377			transport = defs.PreferredTransport
   378		}
   379	
   380		if err := protocol.InitWorkspaceWithTransport(*root, transport); err != nil {
   381			fmt.Fprintf(stderr, "init failed: %v\n", err)
   382			return 1
   383		}
   384	
   385		fmt.Fprintf(stdout, "Initialized Parley Deck workspace at %s\n", filepath.Join(*root, protocol.DeckDir))
   386		if centralPath != "" {
   387			fmt.Fprintf(stdout, "Central agent defaults: %s (override per-project in %s)\n",
   388				centralPath, filepath.Join(*root, protocol.DeckDir, "agents.toml"))
   389		}
   390		return 0
   391	}
   392	
   393	func runAgents(ctx context.Context, args []string, stdout, stderr io.Writer) int {
   394		if len(args) == 0 {
   395			fmt.Fprintln(stderr, "usage: parley agents list|verify")
   396			return 2
   397		}
   398	
   399		switch args[0] {
   400		case "list", "discover":
   401			return runAgentsList(ctx, args[1:], stdout, stderr)
   402		case "verify", "probe":
   403			return runAgentsVerify(ctx, args[1:], stdout, stderr)
   404		default:
   405			fmt.Fprintln(stderr, "usage: parley agents list|verify")
   406			return 2
   407		}
   408	}
   409	
   410	func runAgentsList(ctx context.Context, args []string, stdout, stderr io.Writer) int {
   411		fs := flag.NewFlagSet("agents list", flag.ContinueOnError)
   412		fs.SetOutput(stderr)
   413		root := fs.String("dir", ".", "workspace directory")
   414		if err := fs.Parse(args); err != nil {
   415			return 2
   416		}
   417	
   418		results, err := discoverConfigured(ctx, *root)
   419		if err != nil {
   420			fmt.Fprintf(stderr, "agent config failed: %v\n", err)
   421			return 1
   422		}
   423		agents.PrintRuntimeMatrix(stdout, results)
   424		return 0
   425	}
   426	
   427	func runAgentsVerify(ctx context.Context, args []string, stdout, stderr io.Writer) int {
   428		fs := flag.NewFlagSet("agents verify", flag.ContinueOnError)
   429		fs.SetOutput(stderr)
   430		root := fs.String("dir", ".", "workspace directory")
   431		agentID := fs.String("agent", "", "agent ID to verify")
   432		full := fs.Bool("full", false, "run behavioral headless probes")
   433		yes := fs.Bool("yes", false, "confirm hosted backend probes")
   434		if err := fs.Parse(args); err != nil {
   435			return 2
   436		}
   437	
   438		results, err := discoverConfigured(ctx, *root)
   439		if err != nil {
   440			fmt.Fprintf(stderr, "agent config failed: %v\n", err)
   441			return 1
   442		}
   443		selected, err := selectDiscoveries(results, *agentID)
   444		if err != nil {
   445			fmt.Fprintf(stderr, "verify failed: %v\n", err)
   446			return 2
   447		}
   448		if *full && !*yes {
   449			for _, result := range selected {
   450				if result.ExternalBackend != agents.ExternalLocal {
   451					fmt.Fprintf(stderr, "verify --full for %s may use an external backend; rerun with --yes to confirm\n", result.ID)
   452					return 2
   453				}
   454			}
   455		}
   456	
   457		failed := false
   458		for _, result := range selected {
   459			switch {
   460			case !result.Found:
   461				failed = true
   462				fmt.Fprintf(stdout, "%s: not installed\n", result.ID)
   463				if strings.TrimSpace(*agentID) == "" {
   464					fmt.Fprintln(stdout, "  hint: use --agent ID to verify one configured agent without requiring every built-in agent")
   465				}
   466			case result.Error != "":
   467				failed = true
   468				fmt.Fprintf(stdout, "%s: version probe failed: %s\n", result.ID, result.Error)
   469			default:
   470				fmt.Fprintf(stdout, "%s: installed version=%s\n", result.ID, valueOr(result.Version, "unknown"))
   471			}
   472		}
   473		if failed {
   474			return 1
   475		}
   476		if !*full {
   477			return 0
   478		}
   479	
   480		if err := runFullVerification(ctx, *root, selected, stdout); err != nil {
   481			fmt.Fprintf(stderr, "verify --full failed: %v\n", err)
   482			return 1
   483		}
   484		return 0
   485	}
