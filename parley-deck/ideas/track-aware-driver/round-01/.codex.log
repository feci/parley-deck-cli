   319	func applyFile(root string, specs []agents.Spec, path, source string, optional bool) ([]agents.Spec, error) {
   320		data, err := os.ReadFile(path)
   321		if err != nil {
   322			if optional && errors.Is(err, os.ErrNotExist) {
   323				return specs, nil
   324			}
   325			return nil, err
   326		}
   327	
   328		var cfg fileConfig
   329		if err := toml.Unmarshal(data, &cfg); err != nil {
   330			return nil, fmt.Errorf("%s: %w", path, err)
   331		}
   332	
   333		// Global [defaults].speed applies to every spec (overriding the built-in
   334		// per-agent default); a per-agent override in this same file still wins below.
   335		if cfg.Defaults != nil && strings.TrimSpace(cfg.Defaults.Speed) != "" {
   336			for i := range specs {
   337				specs[i].Speed = cfg.Defaults.Speed
   338				if specs[i].Sources == nil {
   339					specs[i].Sources = map[string]string{}
   340				}
   341				specs[i].Sources["speed"] = source + ":defaults"
   342			}
   343		}
   344	
   345		if len(cfg.Agents) == 0 {
   346			return specs, nil
   347		}
   348	
   349		byID := map[string]int{}
   350		for i, spec := range specs {
   351			byID[spec.ID] = i
   352		}
   353		for id, override := range cfg.Agents {
   354			index, ok := byID[id]
   355			if !ok {
   356				specs = append(specs, agents.Spec{
   357					ID:                    id,
   358					PromptMode:            agents.PromptStdin,
   359					LaunchMode:            agents.LaunchHeadless,
   360					InteractivePromptMode: agents.InteractivePromptNone,
   361					InteractiveInvoke:     agents.InteractiveInvokePrintOnly,
   362					InteractivePollMS:     agents.DefaultInteractivePollMS,
   363					Model:                 agents.CLIDefault,
   364					Reasoning:             agents.CLIDefault,
   365					Profile:               agents.CLIDefault,
   366					Speed:                 agents.DefaultSpeed,
   367					TimeoutMS:             agents.DefaultTimeoutMS,
   368					ExternalBackend:       agents.ExternalUnknown,
   369					Sources:               configDefaultSources(source),
   370				})
   371				index = len(specs) - 1
   372				byID[id] = index
   373			}
   374			spec := specs[index]
   375			spec = applyOverride(root, spec, override, source)
   376			specs[index] = spec
   377		}
   378	
   379		return specs, nil
   380	}
