   339	// GoalCheck (LE-7) runs a fresh non-implementer agent (the review drafter) to check the
   340	// FINAL.md acceptance criteria before close, reusing the consult execution path with a
   341	// verdict prompt. Fail-open on checker error/ambiguity: only a confident FAIL returns
   342	// (false, …) so a broken checker never blocks an already-review-clean idea.
   343	func (o driverImplOps) GoalCheck(ctx context.Context) (bool, string) {
   344		checker := o.drafter
   345		// CF6: GoalCheck must use a non-implementer checker. The upstream guards
   346		// (ReviewerCount < 2 under auto; OpenReviewRound under strict) already prevent
   347		// the drafter==implementer fallback from reaching here, but enforce the contract
   348		// locally too — never run the implementer as its own goal checker; fail open.
   349		if checker == o.implementer {
   350			fmt.Fprintf(o.out, "driver: goal-check skipped — no independent checker (drafter is the implementer) (advisory)\n")
   351			return true, "advisory: goal-check has no independent checker"
   352		}
   353		agent, ok := o.discoveryFor(checker)
   354		if !ok {
   355			fmt.Fprintf(o.out, "driver: goal-check skipped — checker %q not discovered (advisory)\n", checker)
   356			return true, "advisory: goal-check checker unavailable"
   357		}
   358		fmt.Fprintf(o.out, "driver: goal-done check via %s ...\n", checker)
   359		dir := filepath.Join(o.root, protocol.DeckDir, "runs", o.base.RunID, "agents", checker)
   360		_ = os.MkdirAll(dir, 0o755)
   361		res := runner.RunConsult(ctx, runner.ConsultOptions{
   362			Root:  o.root,
   363			Agent: agent,
   364			// CF3: the goal-check is an advisory fail-open gate, so bound it tightly.
   365			// Without an explicit timeout it inherits the agent's full timeout (15-30m);
   366			// a hung checker would then block the driver tick for that long instead of
   367			// failing open quickly. 2 minutes is ample for a single verdict.
   368			Timeout:    2 * time.Minute,
   369			Prompt:     runner.BuildGoalCheckPrompt(agent, o.base.Idea),
   370			StdoutPath: filepath.Join(dir, "goal-check.stdout.log"),
   371			StderrPath: filepath.Join(dir, "goal-check.stderr.log"),
   372			Progress:   o.out,
   373		})
   374		if res.ExitError != "" {
   375			fmt.Fprintf(o.out, "driver: goal-check inconclusive (checker error: %s) — proceeding (advisory)\n", res.ExitError)
   376			return true, "advisory: goal-check checker error"
   377		}
   378		switch parseGoalVerdict(res.Answer) {
   379		case "FAIL":
   380			return false, res.Answer
   381		case "PASS":
   382			return true, ""
   383		default:
   384			fmt.Fprintf(o.out, "driver: goal-check inconclusive (no clear verdict) — proceeding (advisory)\n")
   385			return true, "advisory: goal-check inconclusive"
   386		}
   387	}
   388	
   389	// parseGoalVerdict extracts the last GOAL-CHECK verdict from a goal-check answer
   390	// (case-insensitive). Returns "PASS", "FAIL", or "" (ambiguous / none).
   391	func parseGoalVerdict(answer string) string {
   392		verdict := ""
   393		for _, line := range strings.Split(answer, "\n") {
   394			t := strings.ToUpper(strings.TrimSpace(line))
   395			// CF2: strip leading markdown / quote wrappers (heading, bold, blockquote,
   396			// underscore, backtick, single/double quote) so a wrapped marker like
   397			// `GOAL-CHECK: FAIL` or **GOAL-CHECK:** still matches the prefix.
   398			t = strings.TrimLeft(t, "#*->_ \t`\"'")
   399			if !strings.HasPrefix(t, "GOAL-CHECK:") {
   400				continue
   401			}
   402			// CF4: reset on every matched verdict line so the LAST verdict wins — a
   403			// trailing ambiguous line (e.g. "GOAL-CHECK: RE-EVALUATING") must clear a
   404			// prior PASS/FAIL back to ambiguous rather than leaving it stuck.
   405			verdict = ""
   406			rest := strings.TrimSpace(strings.TrimPrefix(t, "GOAL-CHECK:"))
   407			// CF2: a bolded/quoted marker ("**GOAL-CHECK:** FAIL") leaves "** FAIL" in
   408			// rest — strip the leading wrapper run before the PASS/FAIL prefix check.
   409			rest = strings.TrimLeft(rest, "*`\"'_ ")
   410			switch {
   411			case strings.HasPrefix(rest, "PASS"):
   412				verdict = "PASS"
   413			case strings.HasPrefix(rest, "FAIL"):
   414				verdict = "FAIL"
   415			}
   416		}
   417		return verdict
   418	}
