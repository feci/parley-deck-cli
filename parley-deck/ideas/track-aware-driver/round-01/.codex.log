   558	func cloneSpecs(specs []agents.Spec) []agents.Spec {
   559		out := make([]agents.Spec, len(specs))
   560		for i, spec := range specs {
   561			out[i] = spec
   562			out[i].Commands = append([]string(nil), spec.Commands...)
   563			out[i].VersionArgs = append([]string(nil), spec.VersionArgs...)
   564			out[i].HeadlessArgs = append([]string(nil), spec.HeadlessArgs...)
   565			out[i].ACPArgs = cloneOptionalStringSlice(spec.ACPArgs)
   566			out[i].InteractiveArgs = append([]string(nil), spec.InteractiveArgs...)
   567			if spec.IsolatedHomeEnv != nil {
   568				out[i].IsolatedHomeEnv = map[string]string{}
   569				for key, value := range spec.IsolatedHomeEnv {
   570					out[i].IsolatedHomeEnv[key] = value
   571				}
   572			}
   573			if spec.Sources != nil {
   574				out[i].Sources = map[string]string{}
   575				for key, value := range spec.Sources {
   576					out[i].Sources[key] = value
   577				}
   578			}
   579		}
   580		return out
   581	}
   582	
   583	func cloneOptionalStringSlice(values []string) []string {
   584		if values == nil {
   585			return nil
   586		}
   587		return append([]string{}, values...)
   588	}

