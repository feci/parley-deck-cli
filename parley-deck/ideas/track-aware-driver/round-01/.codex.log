   649	func runStatus(args []string, stdout, stderr io.Writer) int {
   650		fs := flag.NewFlagSet("status", flag.ContinueOnError)
   651		fs.SetOutput(stderr)
   652		root := fs.String("dir", ".", "workspace directory")
   653		runID := fs.String("run", "", "run ID to inspect")
   654		ideaSlug := fs.String("idea", "", "idea slug to inspect")
   655		jsonOut := fs.Bool("json", false, "print unstable JSON output")
   656		if err := fs.Parse(args); err != nil {
   657			return 2
   658		}
   659		if *runID != "" && *ideaSlug != "" {
   660			fmt.Fprintln(stderr, "status accepts only one of --run or --idea")
   661			return 2
   662		}
   663	
   664		status, err := protocol.ReadWorkspaceStatus(*root)
   665		if err != nil {
   666			if errors.Is(err, os.ErrNotExist) {
   667				fmt.Fprintln(stderr, "no parley-deck workspace found; run `parley init` first")
   668				return 1
   669			}
   670			fmt.Fprintf(stderr, "status failed: %v\n", err)
   671			return 1
   672		}
   673	
   674		if *runID != "" {
   675			target := *runID
   676			run, err := runstate.ResolveRun(*root, target)
   677			if err != nil {
   678				fmt.Fprintf(stderr, "status failed: %v\n", err)
   679				return 1
   680			}
   681			if *jsonOut {
   682				return printJSON(stdout, run, stderr)
   683			}
   684			printRunDetail(stdout, run)
   685			return 0
   686		}
   687		if *ideaSlug != "" {
   688			run, err := runstate.ResolveRun(*root, *ideaSlug)
   689			if err == nil {
   690				if *jsonOut {
   691					return printJSON(stdout, run, stderr)
   692				}
   693				printRunDetail(stdout, run)
   694				printConsensusIfPresent(stdout, *root, *ideaSlug)
   695				return 0
   696			}
   697			idea, ok := findIdeaStatus(status, *ideaSlug)
   698			if !ok {
   699				fmt.Fprintf(stderr, "status failed: %v\n", err)
   700				return 1
   701			}
   702			if *jsonOut {
   703				payload := struct {
   704					Idea      protocol.IdeaStatus `json:"idea"`
   705					Consensus *consensus.Summary  `json:"consensus,omitempty"`
   706					Review    *consensus.Summary  `json:"review_consensus,omitempty"`
   707				}{Idea: idea}
   708				if summary, err := consensus.Status(*root, *ideaSlug, false); err == nil {
   709					payload.Consensus = &summary
   710				}
   711				if summary, err := consensus.Status(*root, *ideaSlug, true); err == nil {
   712					payload.Review = &summary
   713				}
   714				return printJSON(stdout, payload, stderr)
   715			}
   716			printIdeaDetail(stdout, idea)
   717			printConsensusIfPresent(stdout, *root, *ideaSlug)
   718			return 0
   719		}
   720	
   721		runs, err := runstate.ListRuns(*root)
   722		if err != nil {
   723			fmt.Fprintf(stderr, "status failed: %v\n", err)
   724			return 1
   725		}
   726		if *jsonOut {
   727			payload := struct {
   728				Workspace protocol.WorkspaceStatus `json:"workspace"`
   729				Runs      []runstate.RunSummary    `json:"runs"`
   730			}{Workspace: status, Runs: runs}
   731			return printJSON(stdout, payload, stderr)
   732		}
   733	
   734		fmt.Fprintf(stdout, "Transport: %s\n", status.Transport)
   735		if len(status.Ideas) == 0 {
   736			fmt.Fprintln(stdout, "Ideas: none")
   737		} else {
   738			fmt.Fprintln(stdout, "Ideas:")
   739			for _, idea := range status.Ideas {
   740				fmt.Fprintf(stdout, "  %s  status=%s  participants=%s%s\n", idea.Slug, idea.Status, strings.Join(idea.Participants, ","), consensusTriageLabel(*root, idea.Slug))
   741			}
   742		}
   743		printRunsOverview(stdout, runs, 10)
   744		return 0
   745	}
