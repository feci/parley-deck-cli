  2374	func confirmLaunch(stdin *os.File, stdout io.Writer, participants []string) bool {
  2375		info, err := stdin.Stat()
  2376		if err != nil || info.Mode()&os.ModeCharDevice == 0 {
  2377			fmt.Fprintf(stdout, "HITL confirmation required before launching agents: %s\n", strings.Join(participants, ", "))
  2378			return false
  2379		}
  2380	
  2381		fmt.Fprintf(stdout, "Launch round-01 with participants %s? [y/N] ", strings.Join(participants, ", "))
  2382		line, err := bufio.NewReader(stdin).ReadString('\n')
  2383		if err != nil {
  2384			return false
  2385		}
  2386		answer := strings.ToLower(strings.TrimSpace(line))
  2387		return answer == "y" || answer == "yes"
  2388	}
