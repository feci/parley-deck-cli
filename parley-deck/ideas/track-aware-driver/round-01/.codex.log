   813	func runSessionsInspect(args []string, stdout, stderr io.Writer) int {
   814		fs := flag.NewFlagSet("sessions inspect", flag.ContinueOnError)
   815		fs.SetOutput(stderr)
   816		root := fs.String("dir", ".", "workspace directory used to disambiguate or inspect an unindexed run")
   817		jsonOut := fs.Bool("json", false, "print JSON output")
   818		if err := fs.Parse(args); err != nil {
   819			return 2
   820		}
   821		if fs.NArg() != 1 {
   822			fmt.Fprintln(stderr, "usage: parley sessions inspect [--dir DIR] [--json] RUN_ID")
   823			return 2
   824		}
   825	
   826		sessionStore, err := sessionstore.Default()
   827		if err != nil {
   828			fmt.Fprintf(stderr, "sessions inspect failed: %v\n", err)
   829			return 1
   830		}
   831		filterRoot := ""
   832		fs.Visit(func(flag *flag.Flag) {
   833			if flag.Name == "dir" {
   834				filterRoot = *root
   835			}
   836		})
   837		session, err := resolveIndexedSession(sessionStore, fs.Arg(0), filterRoot, *root)
   838		if err != nil {
   839			fmt.Fprintf(stderr, "sessions inspect failed: %v\n", err)
   840			return 1
   841		}
   842		payload := inspectSession(sessionStore.Path(), session)
   843		if *jsonOut {
   844			return printJSON(stdout, payload, stderr)
   845		}
   846		printSessionDetail(stdout, payload)
