   266	// centralDefaultTemplate renders a starter central config from the built-in
   267	// specs: one [agents.<id>] block per agent with model + reasoning. Default
   268	// reasoning should be the strongest level each agent supports; edit to taste.
   269	func centralDefaultTemplate() string {
   270		var b strings.Builder
   271		b.WriteString("# ~/.parley/agents.toml — central per-user Parley Deck defaults.\n")
   272		b.WriteString("# Lists each agent's default model and reasoning/effort level. Used by\n")
   273		b.WriteString("# every project unless a deck overrides it in parley-deck/agents.toml.\n")
   274		b.WriteString("# Prefer an exact model id over a vendor \"latest\" alias, and keep the\n")
   275		b.WriteString("# strongest (highest) reasoning level each agent supports.\n\n")
   276		b.WriteString("# Project-wide policy defaults; a deck's parley-deck/agents.toml overrides them.\n")
   277		b.WriteString("[defaults]\n")
   278		b.WriteString("speed = \"deep\"\n")
   279		b.WriteString("ping_tier = \"hosted-pong\"                 # §9.0 roster liveness ping before each idea (or \"none\")\n")
   280		b.WriteString("preferred_transport = \"local-dir\"          # parley init default transport (local-dir|github-pr|gitlab-mr)\n")
   281		b.WriteString("roster_change_policy = \"confirm-breaking\"  # auto-add new agents; user confirms drops/breaking changes\n\n")
   282		b.WriteString("[defaults.timeouts]\n")
   283		b.WriteString("signoff_ms = 600000          # 10 min\n")
   284		b.WriteString("round_ms = 1200000           # 20 min\n")
   285		b.WriteString("review_ms = 1200000          # 20 min\n")
   286		b.WriteString("deep_reasoning_ms = 1200000  # 20 min\n\n")
   287		b.WriteString("[defaults.loop]              # auto-drive loop ceilings (LE-5); breach escalates, never completes. 0 = unlimited.\n")
   288		b.WriteString("max_driver_steps = 200       # total progress steps before escalation (generous safety net)\n")
   289		b.WriteString("max_wall_clock_ms = 7200000  # 2 h total run budget (distinct from the per-tick 30 min round deadline)\n")
   290		b.WriteString("max_cost_usd = 0             # 0 = unlimited; best-effort, telemetry-gated (LE-6)\n\n")
   291		for _, spec := range agents.DefaultSpecs() {
   292			model := spec.Model
   293			if strings.TrimSpace(model) == "" {
   294				model = agents.CLIDefault
   295			}
   296			reasoning := spec.Reasoning
   297			if strings.TrimSpace(reasoning) == "" {
   298				reasoning = agents.CLIDefault
   299			}
