   184	// RunChecks runs the verification gate (LE-4). Resolution order:
   185	//  1. an explicit `checks:` command from 00-prompt frontmatter → `sh -c <command>`;
   186	//  2. else `go test ./...` when the workspace is a Go module;
   187	//  3. else, for a code-writing (auto_implement) idea with no checks → FAIL CLOSED;
   188	//  4. else (design-only, non-Go) → nothing to check.
   189	//
   190	// Because advanceImpl (pre-review) and advanceReview (post-fix-up) both escalate when
   191	// RunChecks fails, step 3 transitively ties the "artifact-wins" fix-up override to a
   192	// real check: a fix-up that wrote a valid-shaped artifact but cannot be verified no
   193	// longer auto-passes (hermes #8).
   194	func (o driverImplOps) RunChecks(ctx context.Context) (bool, string) {
   195		run := func(name string, cmd *exec.Cmd) (bool, string) {
   196			fmt.Fprintf(o.out, "driver: running checks (%s) ...\n", name)
   197			cmd.Dir = o.root
   198			var buf bytes.Buffer
   199			cmd.Stdout = &buf
   200			cmd.Stderr = &buf
   201			err := cmd.Run()
   202			return err == nil, buf.String()
   203		}
   204		checks := ""
   205		if meta, err := protocol.ReadFrontmatter(filepath.Join(o.ideaDir, "00-prompt.md")); err == nil {
   206			checks = strings.TrimSpace(strings.Trim(strings.TrimSpace(meta["checks"]), `"'`))
   207		}
   208		if checks != "" {
   209			return run(checks, exec.CommandContext(ctx, "sh", "-c", checks))
   210		}
   211		if _, err := os.Stat(filepath.Join(o.root, "go.mod")); err == nil {
   212			return run("go test ./...", exec.CommandContext(ctx, "go", "test", "./..."))
   213		}
   214		if driver.ReadAutoImplement(o.ideaDir) {
   215			return false, "no go.mod and no `checks:` configured for a code-writing (auto_implement) idea; set checks: in 00-prompt.md so a fix-up cannot pass unverified"
   216		}
   217		return true, "no go.mod and no checks configured; nothing to check"
   218	}
   219	
   220	func (o driverImplOps) OpenReviewRound(ctx context.Context, round int) error {
   221		if len(o.reviewers) == 0 {
   222			return fmt.Errorf("no non-implementer reviewers available")
   223		}
   224		// LE-3 model-diversity: a checker that shares the implementer's model is more
   225		// likely to rubber-stamp. Default = warn (+event); require_model_diversity escalates.
   226		if err := o.checkModelDiversity(); err != nil {
   227			return err
   228		}
   229		fmt.Fprintf(o.out, "driver: opening review round %d (reviewers: %s) ...\n", round, strings.Join(o.reviewers, ", "))
   230		// AF5: drop any reviewer artifact that exists but fails validation, so
   231		// RunReviewRound (Overwrite=false) regenerates it instead of skipping a
   232		// malformed file forever (which would spin the driver to the deadline).
   233		dir := filepath.Join(o.ideaDir, "review", roundDirLabel(round))
   234		for _, reviewer := range o.reviewers {
   235			path := filepath.Join(dir, reviewer+".md")
   236			if _, err := os.Stat(path); err == nil {
   237				if runner.ValidateReviewArtifact(path, reviewer, o.ideaSlug, round) != nil {
   238					_ = os.Remove(path)
   239				}
   240			}
   241		}
   242		opts := o.withParticipants(o.reviewers...)
   243		opts.Round = round
   244		results := runner.RunReviewRound(ctx, opts)
   245		failed := 0
   246		for _, r := range results {
   247			if r.ExitError != "" {
   248				failed++
   249			}
   250		}
   251		if failed == len(results) && failed > 0 {
   252			return fmt.Errorf("all reviewers failed in review round %d", round)
   253		}
   254		return nil
   255	}
   256	
   257	func (o driverImplOps) ReviewRoundComplete(round int) (bool, error) {
   258		dir := filepath.Join(o.ideaDir, "review", roundDirLabel(round))
   259		for _, reviewer := range o.reviewers {
   260			path := filepath.Join(dir, reviewer+".md")
   261			if _, err := os.Stat(path); err != nil {
   262				return false, nil
   263			}
   264			if err := runner.ValidateReviewArtifact(path, reviewer, o.ideaSlug, round); err != nil {
   265				return false, nil
   266			}
   267		}
   268		return len(o.reviewers) > 0, nil
   269	}
