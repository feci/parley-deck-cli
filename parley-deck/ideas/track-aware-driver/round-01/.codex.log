    23	// driverImplOps is the production driver.ImplOps adapter (driver-impl-phase). It
    24	// reuses the runner Phase 5-8 helpers + review-mode consensus; the driver depends
    25	// only on the driver.ImplOps interface, so internal/driver never imports
    26	// internal/app.
    27	type driverImplOps struct {
    28		base        runner.Options // the round-01 runOpts (Root, RunID, Store, Agents, Idea, Timeout)
    29		root        string
    30		ideaSlug    string
    31		ideaDir     string
    32		implementer string   // FINAL drafter / first participant
    33		reviewers   []string // non-implementer participants
    34		drafter     string   // review-consensus drafter (facilitator)
    35		out         io.Writer
    36	}
    37	
    38	func newDriverImplOps(base runner.Options, root, ideaSlug, ideaDir string, participants []string, out io.Writer) driver.ImplOps {
    39		implementer := resolveImplementer(ideaDir, participants)
    40		// Dedupe to distinct non-implementer IDs (review CF1). Duplicate participant
    41		// IDs (e.g. [impl, rev, rev]) would otherwise (a) inflate ReviewerCount so the
    42		// LE-11 `< 2` guard passes with a single real reviewer, and (b) make
    43		// RunReviewRound launch one goroutine per duplicate, all writing the same
    44		// agents/<id>/stdout.log and review/round-NN/<id>.md concurrently (a write race).
    45		var reviewers []string
    46		seen := make(map[string]bool)
    47		for _, p := range participants {
    48			if p != implementer && !seen[p] {
    49				seen[p] = true
    50				reviewers = append(reviewers, p)
    51			}
    52		}
    53		// The review-consensus drafter MUST be a non-implementer so the implementer
    54		// cannot filter reviewer findings out of the consensus (AF3). Fall back to the
    55		// implementer only if there are somehow no reviewers.
    56		drafter := implementer
    57		if len(reviewers) > 0 {
    58			drafter = reviewers[0]
    59		}
    60		return driverImplOps{
    61			base: base, root: root, ideaSlug: ideaSlug, ideaDir: ideaDir,
    62			implementer: implementer, reviewers: reviewers, drafter: drafter, out: out,
    63		}
    64	}
    65	
    66	// resolveImplementer picks the implementer from durable role metadata (D10/AF6):
    67	// IMPLEMENTATION.md `implementer` (on re-entry), else FINAL.md `implementer` /
    68	// `drafted-by`, validated against participants; otherwise participants[0].
    69	func resolveImplementer(ideaDir string, participants []string) string {
    70		isParticipant := func(id string) bool {
    71			for _, p := range participants {
    72				if p == id {
    73					return true
    74				}
    75			}
    76			return false
    77		}
    78		for _, src := range []struct {
    79			file string
    80			keys []string
    81		}{
    82			{"IMPLEMENTATION.md", []string{"implementer"}},
    83			{"FINAL.md", []string{"implementer", "drafted-by"}},
    84		} {
    85			meta, err := protocol.ReadFrontmatter(filepath.Join(ideaDir, src.file))
    86			if err != nil {
    87				continue
    88			}
    89			for _, k := range src.keys {
    90				id := strings.Trim(strings.TrimSpace(meta[k]), `"'`)
    91				if id != "" && isParticipant(id) {
    92					return id
    93				}
    94			}
    95		}
    96		if len(participants) > 0 {
    97			return participants[0]
    98		}
    99		return ""
   100	}
