   849	
   850	type sessionInspectPayload struct {
   851		IndexPath     string                `json:"index_path"`
   852		Session       sessionstore.Session  `json:"session"`
   853		Manifest      *runmanifest.Manifest `json:"manifest,omitempty"`
   854		ManifestPath  string                `json:"manifest_path,omitempty"`
   855		ManifestError string                `json:"manifest_error,omitempty"`
   856		Run           *runstate.RunSummary  `json:"run,omitempty"`
   857		RunError      string                `json:"run_error,omitempty"`
   858	}
   859	
   860	func resolveIndexedSession(sessionStore sessionstore.Store, target, filterRoot, fallbackRoot string) (sessionstore.Session, error) {
   861		target = strings.TrimSpace(target)
   862		if target == "" {
   863			return sessionstore.Session{}, fmt.Errorf("run ID is required")
   864		}
   865		var rootAbs string
   866		if strings.TrimSpace(filterRoot) != "" {
   867			var err error
   868			rootAbs, err = filepath.Abs(filterRoot)
   869			if err != nil {
   870				return sessionstore.Session{}, err
   871			}
   872		}
   873	
   874		sessions, err := sessionStore.List()
   875		if err != nil {
   876			return sessionstore.Session{}, err
   877		}
   878		var matches []sessionstore.Session
   879		for _, session := range sessions {
   880			if session.RunID != target {
   881				continue
   882			}
   883			if rootAbs != "" && session.WorkspaceRoot != rootAbs {
   884				continue
   885			}
   886			matches = append(matches, session)
   887		}
   888		if len(matches) == 1 {
   889			return matches[0], nil
   890		}
   891		if len(matches) > 1 {
   892			var roots []string
   893			for _, match := range matches {
   894				roots = append(roots, match.WorkspaceRoot)
   895			}
   896			return sessionstore.Session{}, fmt.Errorf("run %s exists in multiple workspaces; retry with --dir (%s)", target, strings.Join(roots, ", "))
   897		}
   898		if strings.TrimSpace(fallbackRoot) == "" {
   899			return sessionstore.Session{}, fmt.Errorf("run %s is not in the local session index", target)
   900		}
   901	
   902		fallbackAbs, err := filepath.Abs(fallbackRoot)
   903		if err != nil {
   904			return sessionstore.Session{}, err
   905		}
   906		run, err := runstate.ResolveRun(fallbackAbs, target)
   907		if err != nil {
   908			if rootAbs == "" {
   909				return sessionstore.Session{}, fmt.Errorf("run %s is not in the local session index and was not found in workspace %s: %w", target, fallbackAbs, err)
   910			}
   911			return sessionstore.Session{}, fmt.Errorf("run %s was not found for workspace %s: %w", target, fallbackAbs, err)
   912		}
   913		return sessionstore.Session{
   914			WorkspaceRoot: fallbackAbs,
   915			RunID:         run.RunID,
   916			IdeaSlug:      run.IdeaSlug,
   917			Task:          run.Task,
   918			Participants:  append([]string(nil), run.Participants...),
   919			UpdatedAt:     time.Now().UTC(),
   920			LastEventAt:   run.LastEventAt,
   921			Terminal:      run.Terminal,
   922		}, nil
   923	}
   924	
   925	func inspectSession(indexPath string, session sessionstore.Session) sessionInspectPayload {
   926		payload := sessionInspectPayload{
   927			IndexPath:    indexPath,
   928			Session:      session,
   929			ManifestPath: runmanifest.Path(session.WorkspaceRoot, session.RunID),
   930		}
   931		manifest, err := runmanifest.Load(session.WorkspaceRoot, session.RunID)
   932		if err == nil {
   933			payload.Manifest = &manifest
   934		} else if !errors.Is(err, os.ErrNotExist) {
   935			payload.ManifestError = err.Error()
   936		}
   937		run, err := runstate.LoadRun(session.WorkspaceRoot, session.RunID)
   938		if err == nil {
   939			payload.Run = &run
   940		} else {
   941			payload.RunError = err.Error()
   942		}
   943		return payload
   944	}
   945	
   946	func printSessionDetail(stdout io.Writer, payload sessionInspectPayload) {
   947		session := payload.Session
   948		fmt.Fprintf(stdout, "Session: %s\n", session.RunID)
   949		fmt.Fprintf(stdout, "Index: %s\n", payload.IndexPath)
   950		fmt.Fprintf(stdout, "Workspace: %s\n", session.WorkspaceRoot)
   951		fmt.Fprintf(stdout, "Idea: %s\n", valueOr(session.IdeaSlug, "unknown"))
   952		if session.Task != "" {
   953			fmt.Fprintf(stdout, "Task: %s\n", session.Task)
   954		}
   955		if len(session.Participants) > 0 {
   956			fmt.Fprintf(stdout, "Participants: %s\n", strings.Join(session.Participants, ","))
   957		}
   958		fmt.Fprintf(stdout, "Status: %s\n", sessionStatus(session))
   959		fmt.Fprintf(stdout, "Last event: %s\n", sessionTimestamp(session))
   960		if payload.Manifest != nil {
   961			fmt.Fprintf(stdout, "Manifest: %s\n", payload.ManifestPath)
   962			fmt.Fprintf(stdout, "Manifest schema: %d\n", payload.Manifest.SchemaVersion)
   963			if payload.Manifest.Status != "" {
   964				fmt.Fprintf(stdout, "Manifest status: %s\n", payload.Manifest.Status)
   965			}
   966			if payload.Manifest.Mode != "" {
   967				fmt.Fprintf(stdout, "Mode: %s\n", payload.Manifest.Mode)
   968			}
   969			if payload.Manifest.Transport != "" {
   970				fmt.Fprintf(stdout, "Transport: %s\n", payload.Manifest.Transport)
   971			}
   972			if !payload.Manifest.CreatedAt.IsZero() {
   973				fmt.Fprintf(stdout, "Created: %s\n", payload.Manifest.CreatedAt.Format(time.RFC3339))
   974			}
   975		} else if payload.ManifestError != "" {
   976			fmt.Fprintf(stdout, "Manifest: error: %s\n", payload.ManifestError)
   977		} else {
   978			fmt.Fprintf(stdout, "Manifest: missing (legacy run; expected at %s)\n", payload.ManifestPath)
   979		}
   980		if payload.RunError != "" {
   981			fmt.Fprintf(stdout, "Run: error: %s\n", payload.RunError)
   982			return
   983		}
   984		if payload.Run != nil {
   985			fmt.Fprintln(stdout)
   986			printRunDetail(stdout, *payload.Run)
   987		}
   988	}
   989	
   990	func sessionStatus(session sessionstore.Session) string {
   991		if manifest, err := runmanifest.Load(session.WorkspaceRoot, session.RunID); err == nil && manifest.Status != "" {
   992			return manifest.Status
   993		}
   994		if session.Terminal {
   995			return "terminal"
   996		}
   997		return "active"
   998	}
   999	
  1000	func sessionStartedTimestamp(session sessionstore.Session) string {
  1001		if session.CreatedAt.IsZero() {
  1002			return "-"
  1003		}
  1004		return session.CreatedAt.Format(time.RFC3339)
  1005	}
  1006	
  1007	func sessionTimestamp(session sessionstore.Session) string {
  1008		value := session.LastEventAt
  1009		if value.IsZero() {
  1010			value = session.UpdatedAt
  1011		}
  1012		if value.IsZero() {
  1013			value = session.CreatedAt
  1014		}
  1015		if value.IsZero() {
  1016			return "-"
  1017		}
  1018		return value.Format(time.RFC3339)
  1019	}
