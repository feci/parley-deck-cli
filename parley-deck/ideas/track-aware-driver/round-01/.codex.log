  1995	
  1996	func selectDiscoveries(results []agents.Discovery, agentID string) ([]agents.Discovery, error) {
  1997		if strings.TrimSpace(agentID) == "" {
  1998			return results, nil
  1999		}
  2000		for _, result := range results {
  2001			if result.ID == agentID {
  2002				return []agents.Discovery{result}, nil
  2003			}
  2004		}
  2005		return nil, fmt.Errorf("unknown agent %s", agentID)
  2006	}
  2007	
  2008	func runFullVerification(ctx context.Context, root string, selected []agents.Discovery, stdout io.Writer) error {
  2009		runID := store.NewRunID(time.Now())
  2010		probeDir := filepath.Join(root, protocol.DeckDir, "meta", "runtime-probes", runID)
  2011		if err := os.MkdirAll(probeDir, 0o755); err != nil {
  2012			return err
  2013		}
  2014		fmt.Fprintf(stdout, "probe dir: %s\n", probeDir)
  2015	
  2016		var failures []string
  2017		for _, result := range selected {
  2018			if err := runHeadlessProbe(ctx, root, probeDir, runID, result, stdout); err != nil {
  2019				fmt.Fprintf(stdout, "%s: full probe failed: %v\n", result.ID, err)
  2020				failures = append(failures, result.ID)
  2021			}
  2022		}
  2023		if len(failures) > 0 {
  2024			return fmt.Errorf("%d full verification probe(s) failed: %s", len(failures), strings.Join(failures, ", "))
  2025		}
  2026		return nil
  2027	}
  2028	
  2029	func runHeadlessProbe(ctx context.Context, root, probeDir, runID string, result agents.Discovery, stdout io.Writer) error {
  2030		outputPath := filepath.Join(probeDir, result.ID+".md")
  2031		sentinel := fmt.Sprintf("# parley-runtime-probe agent=%s run=%s", result.ID, runID)
  2032		prompt := probePrompt(result, outputPath, sentinel)
  2033	
  2034		cmd, cleanup, err := runner.CommandFor(ctx, root, result, prompt)
  2035		if cleanup != nil {
  2036			defer cleanup()
  2037		}
  2038		if err != nil {
  2039			return fmt.Errorf("%s: %w", result.ID, err)
  2040		}
  2041		cmd.Dir = root
  2042		if result.PromptMode == agents.PromptStdin {
  2043			cmd.Stdin = strings.NewReader(prompt)
  2044		}
  2045		var out bytes.Buffer
  2046		var errOut bytes.Buffer
  2047		cmd.Stdout = &out
  2048		cmd.Stderr = &errOut
  2049		if err := cmd.Run(); err != nil {
  2050			return fmt.Errorf("%s headless probe: %w: stdout=%s stderr=%s", result.ID, err, strings.TrimSpace(out.String()), strings.TrimSpace(errOut.String()))
  2051		}
  2052		data, err := os.ReadFile(outputPath)
  2053		if err != nil {
  2054			return fmt.Errorf("%s headless probe did not create %s: %w", result.ID, outputPath, err)
  2055		}
  2056		if !strings.HasPrefix(string(data), sentinel) {
  2057			return fmt.Errorf("%s headless probe sentinel mismatch in %s", result.ID, outputPath)
  2058		}
  2059		fmt.Fprintf(stdout, "%s: headless probe passed\n", result.ID)
  2060		return nil
  2061	}
  2062	
  2063	func probePrompt(result agents.Discovery, outputPath, sentinel string) string {
  2064		extra := ""
  2065		if result.ID == "codex" {
  2066			extra = `
  2067	Before writing the success sentinel, run these Git smoke commands in the current repository:
  2068	
  2069	git status
  2070	git branch tmp-codex-git-test
  2071	git branch -D tmp-codex-git-test
  2072	printf test | git hash-object -w --stdin
  2073	
  2074	If any command fails, do not write the success sentinel. Instead, write the failure and return a short blocker.
  2075	`
  2076		}
  2077		return fmt.Sprintf(`Create exactly this file and no other file:
  2078	%s
  2079	
  2080	The first line must be exactly:
  2081	%s
  2082	%s
  2083	
  2084	After the sentinel, write one short line confirming the headless probe.`, outputPath, sentinel, extra)
  2085	}
  2086	
  2087	func runTUIView(ctx context.Context, root string, stdout, stderr io.Writer) int {
  2088		results, err := discoverConfigured(ctx, root)
  2089		if err != nil {
  2090			fmt.Fprintf(stderr, "agent config failed: %v\n", err)
  2091			return 1
  2092		}
  2093		return runTUIViewWithDiscovery(ctx, root, results, stdout, stderr)
  2094	}
  2095	
  2096	func runTUIViewWithDiscovery(ctx context.Context, root string, results []agents.Discovery, stdout, stderr io.Writer) int {
  2097		status, err := protocol.ReadWorkspaceStatus(root)
  2098		if err != nil {
  2099			if errors.Is(err, os.ErrNotExist) {
  2100				if err := tui.RunInit(root, results); err != nil {
  2101					fmt.Fprintf(stderr, "tui failed: %v\n", err)
  2102					return 1
  2103				}
  2104				// Re-read after the init wizard quits. If the user initialized the
  2105				// workspace, fall through to the unified Home view; if they quit
  2106				// without initializing, there is nothing more to show.
  2107				status, err = protocol.ReadWorkspaceStatus(root)
  2108				if err != nil {
  2109					if errors.Is(err, os.ErrNotExist) {
  2110						return 0
  2111					}
  2112					fmt.Fprintf(stderr, "tui failed: %v\n", err)
  2113					return 1
  2114				}
  2115			} else {
  2116				fmt.Fprintf(stderr, "tui failed: %v\n", err)
  2117				return 1
  2118			}
  2119		}
  2120	
