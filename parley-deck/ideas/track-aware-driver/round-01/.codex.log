   109	// modelOf returns the discovered model id for an agent id, or "" if unknown.
   110	func (o driverImplOps) modelOf(id string) string {
   111		for _, a := range o.base.Agents {
   112			if a.ID == id {
   113				return a.Model
   114			}
   115		}
   116		return ""
   117	}
   118	
   119	// reviewersShareImplementerModel reports whether every reviewer uses the same model as
   120	// the implementer (LE-3). Returns (false, "") when the implementer's model is unknown
   121	// or there are no reviewers — diversity can't be asserted, so it never fires spuriously.
   122	func (o driverImplOps) reviewersShareImplementerModel() (bool, string) {
   123		implModel := o.modelOf(o.implementer)
   124		if implModel == "" || len(o.reviewers) == 0 {
   125			return false, ""
   126		}
   127		for _, r := range o.reviewers {
   128			if !strings.EqualFold(o.modelOf(r), implModel) { // review fix F6: case-insensitive
   129				return false, ""
   130			}
   131		}
   132		return true, implModel
   133	}
   134	
   135	// checkModelDiversity (LE-3) emits the agent.model_diversity event and either warns
   136	// (default) or, with require_model_diversity, returns an escalation error. Extracted so
   137	// OpenReviewRound stays thin and the event/warn/escalate logic is unit-testable without
   138	// launching reviewers (review fixes F4 + F8).
   139	func (o driverImplOps) checkModelDiversity() error {
   140		same, model := o.reviewersShareImplementerModel()
   141		if !same {
   142			return nil
   143		}
   144		required := driver.ReadRequireModelDiversity(o.ideaDir)
   145		action := "warn"
   146		if required {
   147			action = "escalate"
   148		}
   149		if o.base.Store != (store.Store{}) { // F4: best-effort durable event for TUI/state consumers
   150			_ = o.base.Store.Append(store.Event{
   151				Time: time.Now().UTC(),
   152				Type: "agent.model_diversity",
   153				Data: map[string]any{
   154					"idea": o.ideaSlug, "implementer": o.implementer,
   155					"reviewers": append([]string(nil), o.reviewers...),
   156					"model":     model, "required": required, "action": action,
   157				},
   158			})
   159		}
   160		if required {
   161			return fmt.Errorf("require_model_diversity: every reviewer shares the implementer's model %q; refusing to open review (LE-3)", model)
   162		}
   163		fmt.Fprintf(o.out, "driver: WARNING model-diversity — every reviewer shares the implementer's model %q; a same-model checker is more likely to rubber-stamp (LE-3). Set require_model_diversity: true to make this a hard gate.\n", model)
   164		return nil
   165	}
