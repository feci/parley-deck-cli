  2183	// liveSteerKillSeams builds the injected SubmitSteer/KillAgent seams that let the
  2184	// TUI execute a steer (a fresh single-agent attempt whose stdout is the reply)
  2185	// and kill one agent, against a live runner.Handle. internal/tui never imports
  2186	// internal/runner; these plain func seams are the only bridge.
  2187	func liveSteerKillSeams(runCtx context.Context, handle *runner.Handle) (tui.SteerFunc, tui.KillAgentFunc, tui.LivenessFunc) {
  2188		runDir := handle.RunDir
  2189		submit := func(req tui.SteerRequest) (tui.SteerResult, error) {
  2190			// Always keep the durable audit trail (steer.requested/delivered) first.
  2191			rec, err := steer.Submit(runDir, steer.Request{
  2192				Target:    req.Target,
  2193				Agent:     req.AgentID,
  2194				Text:      req.Text,
  2195				CreatedBy: "tui",
  2196			}, time.Now().UTC())
  2197			if err != nil {
  2198				return tui.SteerResult{}, err
  2199			}
  2200			out := tui.SteerResult{ID: rec.ID, Status: "recorded"}
  2201			// Only agent-targeted steers execute; deck steers stay record-only for now.
  2202			if req.Target == steer.TargetAgent {
  2203				att, aerr := handle.RunSteerAttempt(runCtx, runner.SteerAttemptRequest{
  2204					AgentID: req.AgentID,
  2205					Text:    req.Text,
  2206					SteerID: rec.ID,
  2207				})
  2208				if aerr != nil {
  2209					return out, aerr
  2210				}
  2211				if !att.Accepted {
  2212					out.Status = "rejected"
  2213					return out, fmt.Errorf("%s", att.Message)
  2214				}
  2215				out.Status = att.Status
  2216				out.SegmentID = att.SegmentID
  2217				out.StdoutPath = att.StdoutPath
  2218			}
  2219			return out, nil
  2220		}
  2221		kill := killOutcome(func(agentID string) runner.KillResult { return handle.KillAgent(agentID) })
  2222		liveness := func(agentID string) string { return runner.AgentLivenessAt(runDir, agentID) }
  2223		return submit, kill, liveness
  2224	}
