   307	func ExpandPlaceholders(value, root, tempdir string) string {
   308		replacements := map[string]string{
   309			"{root}":    root,
   310			"{deck}":    filepath.Join(root, protocol.DeckDir),
   311			"{tempdir}": tempdir,
   312		}
