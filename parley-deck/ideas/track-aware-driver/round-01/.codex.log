   487	func runConsensus(ctx context.Context, args []string, stdout, stderr io.Writer) int {
   488		if len(args) == 0 {
   489			printConsensusUsage(stderr)
   490			return 2
   491		}
   492		switch args[0] {
   493		case "status":
   494			return runConsensusStatus(args[1:], stdout, stderr)
   495		case "draft":
   496			return runConsensusDraft(args[1:], stdout, stderr)
   497		case "signoff":
   498			return runConsensusSignoff(args[1:], stdout, stderr)
   499		case "request-signoffs":
   500			return runConsensusRequestSignoffs(ctx, args[1:], stdout, stderr)
   501		case "finalize":
   502			return runConsensusFinalize(args[1:], stdout, stderr)
   503		case "reopen":
   504			return runConsensusReopen(args[1:], stdout, stderr)
   505		default:
   506			printConsensusUsage(stderr)
   507			return 2
   508		}
   509	}
