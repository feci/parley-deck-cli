   102	// withParticipants clones the base run options with a narrowed participant set.
   103	func (o driverImplOps) withParticipants(ids ...string) runner.Options {
   104		opts := o.base
   105		opts.Idea.Participants = append([]string(nil), ids...)
   106		return opts
   107	}
