  2226	// killOutcome adapts a KillResult-returning kill into the TUI seam: a failed
  2227	// operation returns a Go error (shown red); success returns its outcome message.
  2228	func killOutcome(do func(agentID string) runner.KillResult) tui.KillAgentFunc {
  2229		return func(agentID string) (string, error) {
  2230			res := do(agentID)
