  1021	func runResume(args []string, stdout, stderr io.Writer) int {
  1022		fs := flag.NewFlagSet("resume", flag.ContinueOnError)
  1023		fs.SetOutput(stderr)
  1024		root := fs.String("dir", ".", "workspace directory")
  1025		noTUI := fs.Bool("no-tui", false, "print run detail without opening the TUI")
  1026		if err := fs.Parse(args); err != nil {
  1027			return 2
  1028		}
  1029		if fs.NArg() != 1 {
  1030			fmt.Fprintln(stderr, "usage: parley resume [--dir DIR] [--no-tui] RUN_OR_IDEA")
  1031			return 2
  1032		}
  1033	
  1034		run, err := runstate.ResolveRun(*root, fs.Arg(0))
  1035		if err != nil {
  1036			fmt.Fprintf(stderr, "resume failed: %v\n", err)
  1037			return 1
  1038		}
  1039		if err := resumePendingConsensusSignoffs(*root, run, stdout); err != nil {
  1040			fmt.Fprintf(stderr, "resume failed: %v\n", err)
  1041			return 1
  1042		}
  1043		if refreshed, err := runstate.ResolveRun(*root, fs.Arg(0)); err == nil {
  1044			run = refreshed
  1045		}
  1046		if *noTUI {
  1047			printRunDetail(stdout, run)
  1048			return 0
  1049		}
  1050	
  1051		status, err := protocol.ReadWorkspaceStatus(*root)
  1052		if err != nil {
  1053			fmt.Fprintf(stderr, "resume failed: %v\n", err)
  1054			return 1
  1055		}
  1056		idea := ideaForRun(status, run)
  1057		resumeKill, resumeLiveness := reattachSeams(run.RunDir)
  1058		if err := tui.RunLive(tui.LiveOptions{
  1059			Status:           status,
  1060			Idea:             idea,
  1061			Participants:     run.Participants,
  1062			RunID:            run.RunID,
  1063			RunDir:           run.RunDir,
  1064			Resume:           true,
  1065			KillAgent:        resumeKill,     // durable kill across the restart
  1066			Liveness:         resumeLiveness, // RUN vs STALE badge
  1067			Root:             *root,
  1068			ReattachKill:     func(runID string) tui.KillAgentFunc { k, _ := reattachSeams(runDirFor(*root, runID)); return k },
  1069			ReattachLiveness: func(runID string) tui.LivenessFunc { _, l := reattachSeams(runDirFor(*root, runID)); return l },
  1070		}); err != nil {
  1071			fmt.Fprintf(stderr, "resume tui failed: %v\n", err)
  1072			return 1
  1073		}
  1074		return 0
  1075	}
  1076	
  1077	func runContinue(ctx context.Context, args []string, stdout, stderr io.Writer) int {
  1078		fs := flag.NewFlagSet("continue", flag.ContinueOnError)
  1079		fs.SetOutput(stderr)
  1080		root := fs.String("dir", ".", "workspace directory")
  1081		jsonOut := fs.Bool("json", false, "print unstable JSON output")
  1082		auto := fs.Bool("auto", false, "execute the next action (auto-drive) instead of only printing it")
  1083		noImplement := fs.Bool("no-implement", false, "stop the auto-driver at FINAL.md (skip code-writing implementation/fix-up phases)")
  1084		if err := fs.Parse(args); err != nil {
  1085			return 2
  1086		}
  1087		if fs.NArg() != 1 {
  1088			fmt.Fprintln(stderr, "usage: parley continue [--dir DIR] [--json] [--auto] RUN_OR_IDEA")
  1089			return 2
  1090		}
  1091	
  1092		run, err := runstate.ResolveRun(*root, fs.Arg(0))
  1093		if err != nil {
  1094			fmt.Fprintf(stderr, "continue failed: %v\n", err)
  1095			return 1
  1096		}
  1097		if *auto {
  1098			return continueAuto(ctx, *root, run, *noImplement, stdout, stderr)
  1099		}
  1100		steers, _ := steer.List(run.RunDir)
  1101		if *jsonOut {
  1102			payload := struct {
  1103				Run     runstate.RunSummary  `json:"run"`
  1104				Actions []runplan.NextAction `json:"actions"`
  1105				Steers  []steer.Queued       `json:"steers,omitempty"`
  1106			}{Run: run, Actions: run.NextActions, Steers: steers}
  1107			return printJSON(stdout, payload, stderr)
  1108		}
  1109	
  1110		fmt.Fprintf(stdout, "Run: %s\n", run.RunID)
  1111		fmt.Fprintf(stdout, "Idea: %s\n", valueOr(run.IdeaSlug, "unknown"))
  1112		fmt.Fprintf(stdout, "State: %s\n", displayRunState(run))
  1113		printNextActions(stdout, run)
  1114		printQueuedSteers(stdout, steers)
  1115		return 0
  1116	}
  1117	
  1118	// continueAuto reconstructs the driver for an existing run and ticks it forward
  1119	// (consensus D9): `parley continue --auto` EXECUTES the next action instead of
  1120	// only printing it. Reuses the same gates/adapters as `parley run --auto`.
  1121	// loopBudget resolves the LE-5 auto-drive loop ceilings from the layered config
  1122	// (~/.parley [defaults.loop] seeds them, the deck overrides). 0 = unlimited. Run-flag
  1123	// overrides (including an explicit 0 = unlimited) are applied by the caller via
  1124	// flag.Visit so absence stays distinct from a deliberate 0 (review fix F-T2-1).
  1125	func loopBudget(root string) (steps int, wall time.Duration, cost float64) {
  1126		if defs, err := config.LoadDefaults(root); err == nil {
  1127			steps = defs.MaxDriverSteps
  1128			wall = time.Duration(defs.MaxWallClockMS) * time.Millisecond
  1129			cost = defs.MaxCostUSD
  1130		}
  1131		return steps, wall, cost
  1132	}
  1133	
  1134	func continueAuto(ctx context.Context, root string, run runstate.RunSummary, noImplement bool, stdout, stderr io.Writer) int {
  1135		if run.IdeaSlug == "" || run.IdeaSlug == "unknown" {
  1136			fmt.Fprintln(stderr, "continue --auto failed: run has no idea slug")
  1137			return 1
  1138		}
  1139		discovered, err := discoverConfigured(ctx, root)
  1140		if err != nil {
  1141			fmt.Fprintf(stderr, "agent config failed: %v\n", err)
  1142			return 1
  1143		}
  1144		ideaDir := filepath.Join(root, protocol.DeckDir, "ideas", run.IdeaSlug)
  1145		idea := protocol.IdeaStatus{Slug: run.IdeaSlug, Path: ideaDir, Participants: run.Participants}
  1146		runOpts := runner.Options{
  1147			Root:   root,
  1148			RunID:  run.RunID,
  1149			Idea:   idea,
  1150			Agents: discovered,
  1151			Store:  store.New(run.RunDir),
  1152		}
  1153		lbSteps, lbWall, lbCost := loopBudget(root)
  1154		d := driver.New(driver.Config{
  1155			IdeaDir:           ideaDir,
  1156			IdeaSlug:          run.IdeaSlug,
  1157			Participants:      run.Participants,
  1158			RunDir:            run.RunDir,
  1159			Root:              root,
  1160			Events:            runOpts.Store,
  1161			CrossReviewRounds: driver.ReadCrossReviewRounds(ideaDir),
  1162			Auto:              true,
  1163			Consensus:         newDriverConsensusOps(root, run.IdeaSlug, ideaDir, run.Participants, discovered, stdout),
  1164			Impl:              newDriverImplOps(runOpts, root, run.IdeaSlug, ideaDir, run.Participants, stdout),
  1165			AutoImplement:     driver.ReadAutoImplement(ideaDir) && !noImplement,
  1166			StrictGate:        driver.ReadStrictGate(ideaDir),
  1167			MaxDriverSteps:    lbSteps,
  1168			MaxWallClock:      lbWall,
  1169			MaxCostUSD:        lbCost,
  1170			Out:               stdout,
  1171		}, driver.NewRunnerAdapter(runOpts))
  1172		if err := d.Run(ctx); err != nil {
  1173			fmt.Fprintf(stderr, "continue --auto: %v\n", err)
  1174			return 1
  1175		}
  1176		if updated, err := runstate.LoadRun(root, run.RunID); err == nil {
  1177			registerWorkspaceSessions(root, []runstate.RunSummary{updated})
  1178		}
  1179		return 0
  1180	}
  1181	
  1182	// runSteer queues a follow-up / steering instruction for an agent (or the whole
  1183	// deck) on an existing run. It records the steer as durable events; it does not
  1184	// execute delivery (the queued attempt runs when the agent next executes).
  1185	func runSteer(args []string, stdout, stderr io.Writer) int {
  1186		fs := flag.NewFlagSet("steer", flag.ContinueOnError)
  1187		fs.SetOutput(stderr)
  1188		root := fs.String("dir", ".", "workspace directory")
  1189		agent := fs.String("agent", "", "target agent ID (omit to steer the whole deck)")
  1190		jsonOut := fs.Bool("json", false, "print unstable JSON output")
  1191		if err := fs.Parse(args); err != nil {
  1192			return 2
  1193		}
  1194		if fs.NArg() < 2 {
  1195			fmt.Fprintln(stderr, "usage: parley steer [--dir DIR] [--agent AGENT] [--json] RUN_OR_IDEA -- TEXT...")
  1196			return 2
  1197		}
  1198	
  1199		run, err := runstate.ResolveRun(*root, fs.Arg(0))
  1200		if err != nil {
  1201			fmt.Fprintf(stderr, "steer failed: %v\n", err)
  1202			return 1
  1203		}
  1204		// The run id is a positional, so Go's flag parser stops before any trailing
  1205		// "--"; accept it as an optional separator before the text.
  1206		rest := fs.Args()[1:]
  1207		if len(rest) > 0 && rest[0] == "--" {
  1208			rest = rest[1:]
  1209		}
  1210		text := strings.TrimSpace(strings.Join(rest, " "))
  1211		if text == "" {
  1212			fmt.Fprintln(stderr, "steer failed: instruction text is required")
  1213			fmt.Fprintln(stderr, "usage: parley steer [--dir DIR] [--agent AGENT] [--json] RUN_OR_IDEA -- TEXT...")
  1214			return 2
  1215		}
  1216		agentID := strings.TrimSpace(*agent)
  1217		target := steer.TargetDeck
  1218		if agentID != "" {
  1219			target = steer.TargetAgent
  1220			if !contains(run.Participants, agentID) {
  1221				fmt.Fprintf(stderr, "warning: %q is not a participant of run %s; queuing anyway\n", agentID, run.RunID)
  1222			}
  1223		}
  1224		result, err := steer.Submit(run.RunDir, steer.Request{
  1225			Target:    target,
  1226			Agent:     agentID,
  1227			Text:      text,
  1228			CreatedBy: "cli",
  1229			SegmentID: segmentForAgent(run, agentID),
  1230		}, time.Now().UTC())
  1231		if err != nil {
  1232			fmt.Fprintf(stderr, "steer failed: %v\n", err)
  1233			return 1
  1234		}
  1235		if *jsonOut {
  1236			return printJSON(stdout, result, stderr)
  1237		}
  1238		if target == steer.TargetAgent {
  1239			fmt.Fprintf(stdout, "Recorded %s for %s (queued; auto-exec is not wired up yet).\n", result.ID, agentID)
  1240		} else {
  1241			fmt.Fprintf(stdout, "Recorded %s for the deck (queued; auto-exec is not wired up yet).\n", result.ID)
  1242		}
  1243		return 0
  1244	}
  1245	
  1246	func segmentForAgent(run runstate.RunSummary, agentID string) string {
  1247		if agentID == "" {
  1248			return ""
  1249		}
  1250		for _, a := range run.State.Agents {
  1251			if a.ID == agentID {
  1252				return a.Segment
  1253			}
  1254		}
  1255		return ""
  1256	}
  1257	
  1258	func printQueuedSteers(stdout io.Writer, steers []steer.Queued) {
  1259		if len(steers) == 0 {
  1260			return
  1261		}
  1262		fmt.Fprintf(stdout, "Queued steers (%d):\n", len(steers))
  1263		for _, s := range steers {
  1264			target := s.Target
  1265			if s.Agent != "" {
  1266				target = s.Agent
  1267			}
  1268			fmt.Fprintf(stdout, "  %s  %-8s  %-7s  %s\n", s.ID, target, s.Status, truncateForList(s.Text))
  1269		}
  1270	}
  1271	
  1272	func truncateForList(text string) string {
  1273		text = strings.TrimSpace(strings.ReplaceAll(text, "\n", " "))
  1274		if len(text) > 60 {
  1275			return text[:57] + "..."
  1276		}
  1277		return text
  1278	}
  1279	
  1280	func resumePendingConsensusSignoffs(root string, run runstate.RunSummary, stdout io.Writer) error {
  1281		if run.Mode != "consensus-signoff" {
  1282			return nil
  1283		}
  1284		events, err := store.New(run.RunDir).Load()
  1285		if err != nil {
  1286			return err
  1287		}
  1288		review := false
  1289		for _, event := range events {
  1290			if event.Type != "run.created" {
  1291				continue
  1292			}
  1293			if value, ok := event.Data["review"].(bool); ok {
  1294				review = value
  1295			}
  1296		}
  1297		summary, err := consensus.Status(root, run.IdeaSlug, review)
  1298		if err != nil {
  1299			return err
  1300		}
  1301		if len(summary.Errors) > 0 {
  1302			return fmt.Errorf("target consensus is malformed: %s", strings.Join(summary.Errors, "; "))
  1303		}
  1304		completed := map[string]bool{}
  1305		var pending []store.Event
  1306		for _, event := range events {
  1307			agent := eventAgent(event)
  1308			if agent == "" {
  1309				continue
  1310			}
  1311			switch event.Type {
  1312			case "agent.handoff.completed":
  1313				completed[agent] = true
  1314			case "agent.handoff.pending", "agent.handoff.started":
  1315				pending = append(pending, event)
  1316			}
  1317		}
  1318		signed := map[string]bool{}
  1319		for _, signoff := range summary.Signoffs {
  1320			signed[signoff.Agent] = true
  1321		}
  1322		runStore := store.New(run.RunDir)
  1323		for _, event := range pending {
  1324			agent := eventAgent(event)
  1325			if completed[agent] || !signed[agent] {
  1326				continue
  1327			}
  1328			if err := validateResumedConsensusHandoff(event, summary); err != nil {
  1329				return err
  1330			}
  1331			artifact := ""
  1332			if value, ok := event.Data["artifact"].(string); ok {
  1333				artifact = value
  1334			}
  1335			if err := runStore.Append(store.Event{
  1336				Time: time.Now().UTC(),
  1337				Type: "agent.handoff.completed",
  1338				Data: map[string]any{
  1339					"agent":       agent,
  1340					"artifact":    artifact,
  1341					"launch_mode": event.Data["launch_mode"],
  1342				},
  1343			}); err != nil {
  1344				return err
  1345			}
  1346			completed[agent] = true
  1347			fmt.Fprintf(stdout, "Validated pending signoff from %s.\n", agent)
  1348		}
  1349		return nil
  1350	}
  1351	
  1352	func validateResumedConsensusHandoff(event store.Event, summary consensus.Summary) error {
  1353		agent := eventAgent(event)
  1354		artifact, _ := event.Data["artifact"].(string)
  1355		if agent == "" || artifact == "" {
  1356			return fmt.Errorf("pending handoff event is missing agent or artifact")
  1357		}
  1358		beforeLen, ok := eventDataInt(event.Data, "before_len")
  1359		if !ok || beforeLen < 0 {
  1360			return fmt.Errorf("pending handoff for %s is missing before_len", agent)
  1361		}
  1362		beforeHash, _ := event.Data["before_sha256"].(string)
  1363		if beforeHash == "" {
  1364			return fmt.Errorf("pending handoff for %s is missing before_sha256", agent)
  1365		}
  1366		data, err := os.ReadFile(artifact)
  1367		if err != nil {
  1368			return err
  1369		}
  1370		if len(data) < beforeLen {
  1371			return fmt.Errorf("%s changed existing consensus content before %s signoff", agent, agent)
  1372		}
  1373		beforeRaw := string(data[:beforeLen])
  1374		afterRaw := string(data)
  1375		if got := sha256Hex(beforeRaw); got != beforeHash {
  1376			return fmt.Errorf("%s changed existing consensus content before append-only suffix", agent)
  1377		}
  1378		if err := validateAppendOnlyContent(beforeRaw, afterRaw, agent); err != nil {
  1379			return err
  1380		}
  1381		var found bool
  1382		for _, signoff := range summary.Signoffs {
  1383			if signoff.Agent != agent {
  1384				continue
  1385			}
  1386			found = true
  1387			status, err := consensus.CanonicalStatus(signoff.Status)
  1388			if err != nil {
  1389				return err
  1390			}
  1391			if status == consensus.StatusBlock {
  1392				return fmt.Errorf("%s appended BLOCK signoff", agent)
  1393			}
  1394		}
  1395		if !found {
  1396			return fmt.Errorf("%s did not append a signoff", agent)
  1397		}
  1398		return nil
  1399	}
  1400	
  1401	func eventDataInt(data map[string]any, key string) (int, bool) {
  1402		switch value := data[key].(type) {
  1403		case int:
  1404			return value, true
  1405		case float64:
  1406			return int(value), true
  1407		default:
  1408			return 0, false
  1409		}
  1410	}
  1411	
  1412	func eventAgent(event store.Event) string {
  1413		if event.Data == nil {
  1414			return ""
  1415		}
  1416		value, _ := event.Data["agent"].(string)
  1417		return value
  1418	}
  1419	
  1420	func printJSON(stdout io.Writer, value any, stderr io.Writer) int {
  1421		encoder := json.NewEncoder(stdout)
  1422		encoder.SetIndent("", "  ")
  1423		if err := encoder.Encode(value); err != nil {
  1424			fmt.Fprintf(stderr, "json failed: %v\n", err)
  1425			return 1
  1426		}
  1427		return 0
  1428	}
  1429	
  1430	func printRunsOverview(stdout io.Writer, runs []runstate.RunSummary, limit int) {
  1431		if len(runs) == 0 {
  1432			fmt.Fprintln(stdout, "Runs: none")
  1433			return
  1434		}
  1435		fmt.Fprintln(stdout, "Runs:")
  1436		if limit <= 0 || limit > len(runs) {
  1437			limit = len(runs)
  1438		}
  1439		for _, run := range runs[:limit] {
  1440			if run.Error != "" {
  1441				fmt.Fprintf(stdout, "  %s  error=%s\n", run.RunID, run.Error)
  1442				continue
  1443			}
  1444			fmt.Fprintf(stdout, "  %s  idea=%s  state=%s  agents=%s  questions=%d open\n",
  1445				run.RunID,
  1446				valueOr(run.IdeaSlug, "unknown"),
  1447				displayRunState(run),
  1448				agentProgress(run),
  1449				run.OpenQuestions,
  1450			)
  1451		}
  1452		if len(runs) > limit {
  1453			fmt.Fprintf(stdout, "  ... %d older run(s) hidden; use --run RUN_ID for details\n", len(runs)-limit)
  1454		}
  1455	}
  1456	
  1457	func printRunDetail(stdout io.Writer, run runstate.RunSummary) {
  1458		fmt.Fprintf(stdout, "Run: %s\n", run.RunID)
  1459		fmt.Fprintf(stdout, "Idea: %s\n", valueOr(run.IdeaSlug, "unknown"))
  1460		if run.Task != "" {
  1461			fmt.Fprintf(stdout, "Task: %s\n", run.Task)
  1462		}
  1463		if run.Mode != "" {
  1464			fmt.Fprintf(stdout, "Mode: %s\n", run.Mode)
  1465		}
  1466		if run.Error != "" {
  1467			fmt.Fprintf(stdout, "State: error: %s\n", run.Error)
  1468			return
  1469		}
  1470		fmt.Fprintf(stdout, "State: %s\n", displayRunState(run))
  1471		fmt.Fprintf(stdout, "Open questions: %d\n", run.OpenQuestions)
  1472	
  1473		if len(run.State.Agents) > 0 {
  1474			fmt.Fprintln(stdout, "Agents:")
  1475			for _, agent := range run.State.Agents {
  1476				fmt.Fprintf(stdout, "  %-10s state=%-10s duration=%-8s latest=%s\n",
  1477					agent.ID,
  1478					agent.State,
  1479					formatDuration(agentDuration(agent)),
  1480					valueOr(agent.LatestEvent, "-"),
  1481				)
  1482				if agent.ArtifactPath != "" {
  1483					fmt.Fprintf(stdout, "             artifact: %s\n", agent.ArtifactPath)
  1484				}
  1485				if agent.StdoutPath != "" || agent.StderrPath != "" {
  1486					fmt.Fprintf(stdout, "             logs: stdout=%s stderr=%s\n", valueOr(agent.StdoutPath, "-"), valueOr(agent.StderrPath, "-"))
  1487				}
  1488				if agent.Error != "" {
  1489					fmt.Fprintf(stdout, "             error: %s\n", agent.Error)
  1490				}
  1491				if agent.Reason != "" {
  1492					fmt.Fprintf(stdout, "             reason: %s\n", agent.Reason)
  1493				}
  1494			}
  1495		}
  1496	
  1497		if len(run.Questions) > 0 {
  1498			fmt.Fprintln(stdout, "Open HITL questions:")
  1499			printed := false
  1500			for _, question := range run.Questions {
  1501				if question.Status != hitl.StatusOpen {
  1502					continue
  1503				}
  1504				printed = true
  1505				fmt.Fprintf(stdout, "  %s  agent=%s  risk=%s  %s\n", question.ID, question.Agent, question.Risk, question.Prompt)
  1506			}
  1507			if !printed {
  1508				fmt.Fprintln(stdout, "  none")
  1509			}
  1510		}
  1511	
  1512		if len(run.State.Recent) > 0 {
  1513			fmt.Fprintln(stdout, "Recent events:")
  1514			for _, event := range run.State.Recent {
  1515				fmt.Fprintf(stdout, "  %s  %-16s %s\n", event.Time.Format(time.RFC3339), event.Type, event.Text)
  1516			}
  1517		}
  1518	
  1519		fmt.Fprintf(stdout, "Next: %s\n", nextRunAction(run))
  1520	}
