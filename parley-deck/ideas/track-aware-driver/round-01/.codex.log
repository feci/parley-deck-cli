   315	func hasRespondingTo(path string) bool {
   316		_, ok := readFrontmatterField(path, "responding-to")
   317		return ok
   318	}
   319	
   320	// validateCrossReviewBody enforces the D4 cross-review evidence: the artifact must
   321	// contain a `### @<other>` heading for every other active participant.
   322	func validateCrossReviewBody(path, agent string, participants []string) error {
   323		data, err := os.ReadFile(path)
   324		if err != nil {
   325			return err
   326		}
   327		body := string(data)
   328		for _, other := range participants {
   329			if other == agent {
   330				continue
   331			}
   332			if !strings.Contains(body, "### @"+other) {
   333				return fmt.Errorf("%s missing cross-review heading ### @%s", path, other)
   334			}
   335		}
   336		return nil
   337	}
