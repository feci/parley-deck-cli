   116	// configLayers lists the agent/defaults config files in low-to-high precedence:
   117	// the user-global central default (~/.parley/agents.toml) seeds every project,
   118	// the project deck files override it, and $PARLEY_HEADLESS_AGENT_CONFIG wins.
   119	func configLayers(root string) []configLayer {
   120		deck := filepath.Join(root, protocol.DeckDir)
   121		layers := []configLayer{}
   122		if central := CentralAgentsPath(); central != "" {
   123			layers = append(layers, configLayer{path: central, source: "~/.parley/agents.toml", optional: true})
   124		}
   125		layers = append(layers,
   126			configLayer{path: filepath.Join(deck, "agents.toml"), source: "parley-deck/agents.toml", optional: true},
   127			configLayer{path: filepath.Join(deck, "agents.local.toml"), source: "parley-deck/agents.local.toml", optional: true},
   128		)
   129		if envPath := strings.TrimSpace(os.Getenv(EnvAgentConfig)); envPath != "" {
   130			if !filepath.IsAbs(envPath) {
   131				envPath = filepath.Join(root, envPath)
   132			}
   133			layers = append(layers, configLayer{path: envPath, source: EnvAgentConfig + ":" + envPath, optional: false})
   134		}
   135		return layers
   136	}
