   104			// artifact and sets idea status back to the latest (now `next`) round.
   105			if err := d.cfg.Consensus.Reopen(ctx, "consensus blocked; opening another cross-review round seeded by the BLOCK counter-proposal"); err != nil {
   106				return ActionEscalated, c, fmt.Errorf("reopen consensus: %w", err)
   107			}
