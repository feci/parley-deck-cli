  1528	func printConsensusIfPresent(stdout io.Writer, root, ideaSlug string) {
  1529		if summary, err := consensus.Status(root, ideaSlug, false); err == nil {
  1530			printConsensusSummary(stdout, summary)
  1531		} else if !errors.Is(err, os.ErrNotExist) {
  1532			fmt.Fprintf(stdout, "Consensus: error: %v\n", err)
  1533		}
  1534		if summary, err := consensus.Status(root, ideaSlug, true); err == nil {
  1535			printConsensusSummary(stdout, summary)
  1536		} else if !errors.Is(err, os.ErrNotExist) {
  1537			fmt.Fprintf(stdout, "Review consensus: error: %v\n", err)
  1538		}
  1539	}
  1540	
  1541	func printConsensusSummary(stdout io.Writer, summary consensus.Summary) {
  1542		label := "Consensus"
  1543		if summary.Review {
  1544			label = "Review consensus"
  1545		}
  1546		fmt.Fprintf(stdout, "%s: %s\n", label, summary.Triage)
  1547		fmt.Fprintf(stdout, "Path: %s\n", summary.Path)
  1548		if len(summary.Missing) > 0 {
  1549			fmt.Fprintf(stdout, "Missing signoffs: %s\n", strings.Join(summary.Missing, ","))
  1550		}
  1551		if len(summary.Errors) > 0 {
  1552			fmt.Fprintln(stdout, "Errors:")
  1553			for _, errText := range summary.Errors {
  1554				fmt.Fprintf(stdout, "  %s\n", errText)
  1555			}
  1556		}
  1557		if len(summary.Signoffs) == 0 {
  1558			fmt.Fprintln(stdout, "Signoffs: none")
  1559			return
  1560		}
  1561		fmt.Fprintln(stdout, "Signoffs:")
  1562		for _, signoff := range summary.Signoffs {
  1563			fmt.Fprintf(stdout, "  %-10s %s", signoff.Agent, signoff.Status)
  1564			if signoff.Notes != "" {
  1565				fmt.Fprintf(stdout, " — %s", signoff.Notes)
  1566			}
  1567			fmt.Fprintln(stdout)
  1568		}
  1569	}
  1570	
  1571	func consensusTriageLabel(root, ideaSlug string) string {
  1572		summary, err := consensus.Status(root, ideaSlug, false)
  1573		if err != nil {
  1574			if errors.Is(err, os.ErrNotExist) {
  1575				return ""
  1576			}
  1577			return "  consensus=error"
  1578		}
  1579		if len(summary.Errors) > 0 {
  1580			return "  consensus=error"
  1581		}
  1582		return "  consensus=" + summary.Triage
  1583	}
  1584	
  1585	func displayRunState(run runstate.RunSummary) string {
  1586		if run.Terminal {
  1587			return valueOr(run.Outcome, "unknown")
  1588		}
  1589		state := valueOr(run.Liveness, "idle")
  1590		if !run.LastEventAt.IsZero() {
  1591			return fmt.Sprintf("%s — last event %s ago", state, formatDuration(run.LastEventAge))
  1592		}
  1593		return state
  1594	}
  1595	
  1596	func agentProgress(run runstate.RunSummary) string {
  1597		total := len(run.State.Agents)
  1598		if total == 0 {
  1599			total = len(run.Participants)
  1600		}
  1601		if total == 0 {
  1602			return "-"
  1603		}
  1604		done := 0
  1605		for _, agent := range run.State.Agents {
  1606			switch agent.State {
  1607			case runstate.StateFinished, runstate.StateFailed, runstate.StateSkipped:
  1608				done++
  1609			}
  1610		}
  1611		return fmt.Sprintf("%d/%d", done, total)
  1612	}
  1613	
  1614	func agentDuration(agent runstate.AgentState) time.Duration {
  1615		if agent.Duration > 0 {
  1616			return agent.Duration
  1617		}
  1618		if agent.State == runstate.StateRunning && !agent.StartedAt.IsZero() {
  1619			if elapsed := time.Since(agent.StartedAt); elapsed > 0 {
  1620				return elapsed
  1621			}
  1622		}
  1623		return 0
  1624	}
  1625	
  1626	func formatDuration(value time.Duration) string {
  1627		if value <= 0 {
  1628			return "-"
  1629		}
  1630		if value < time.Second {
  1631			return value.Round(time.Millisecond).String()
  1632		}
  1633		return value.Round(time.Second).String()
  1634	}
  1635	
  1636	func nextRunAction(run runstate.RunSummary) string {
  1637		if len(run.NextActions) > 0 {
  1638			if command := runaction.Command(run.NextActions[0], run.RunID, run.IdeaSlug); command != "" {
  1639				return command
  1640			}
  1641			return fmt.Sprintf("parley continue %s", run.RunID)
  1642		}
  1643		for _, question := range run.Questions {
  1644			if question.Status == hitl.StatusOpen {
  1645				return fmt.Sprintf("parley answer %s %s <answer>", run.RunID, question.ID)
  1646			}
  1647		}
  1648		if !run.Terminal {
  1649			return fmt.Sprintf("parley resume %s", run.RunID)
  1650		}
  1651		return "no recoverable action; inspect artifacts/logs"
  1652	}
  1653	
  1654	func printNextActions(stdout io.Writer, run runstate.RunSummary) {
  1655		if len(run.NextActions) == 0 {
  1656			fmt.Fprintln(stdout, "Next actions: none")
  1657			return
  1658		}
  1659		fmt.Fprintf(stdout, "Recommended: %s\n", actionSummary(run.NextActions[0]))
  1660		if command := runaction.Command(run.NextActions[0], run.RunID, run.IdeaSlug); command != "" {
  1661			fmt.Fprintf(stdout, "Command: %s\n", command)
  1662		}
  1663		fmt.Fprintln(stdout, "Next actions:")
  1664		for _, action := range run.NextActions {
  1665			fmt.Fprintf(stdout, "  %s  kind=%s  risk=%s", action.ID, action.Kind, valueOr(action.Risk, "-"))
  1666			if action.AgentID != "" {
  1667				fmt.Fprintf(stdout, "  agent=%s", action.AgentID)
  1668			}
  1669			if action.ArtifactPath != "" {
  1670				fmt.Fprintf(stdout, "  artifact=%s", action.ArtifactPath)
  1671			}
  1672			if action.RequiresYes {
  1673				fmt.Fprint(stdout, "  requires=yes")
  1674			}
  1675			fmt.Fprintf(stdout, "\n      %s\n", actionSummary(action))
  1676			if command := runaction.Command(action, run.RunID, run.IdeaSlug); command != "" {
  1677				fmt.Fprintf(stdout, "      command: %s\n", command)
  1678			}
  1679		}
  1680	}
  1681	
  1682	func actionSummary(action runplan.NextAction) string {
  1683		return valueOr(action.Summary, action.Kind)
  1684	}
  1685	
  1686	func findIdeaStatus(status protocol.WorkspaceStatus, slug string) (protocol.IdeaStatus, bool) {
  1687		for _, idea := range status.Ideas {
  1688			if idea.Slug == slug {
  1689				return idea, true
  1690			}
  1691		}
  1692		return protocol.IdeaStatus{}, false
  1693	}
  1694	
  1695	func ideaForRun(status protocol.WorkspaceStatus, run runstate.RunSummary) protocol.IdeaStatus {
  1696		for _, idea := range status.Ideas {
  1697			if idea.Slug == run.IdeaSlug {
  1698				return idea
  1699			}
  1700		}
  1701		slug := valueOr(run.IdeaSlug, "unknown")
  1702		idea := protocol.IdeaStatus{
  1703			Slug:         slug,
  1704			Status:       "unknown",
  1705			Participants: run.Participants,
  1706		}
  1707		if slug != "unknown" {
  1708			idea.Path = filepath.Join(status.Root, protocol.DeckDir, "ideas", slug)
  1709		}
  1710		return idea
  1711	}
  1712	
  1713	func runTask(ctx context.Context, args []string, stdout, stderr io.Writer) int {
  1714		fs := flag.NewFlagSet("run", flag.ContinueOnError)
  1715		fs.SetOutput(stderr)
  1716		noTUI := fs.Bool("no-tui", false, "run without opening the TUI after the round")
  1717		auto := fs.Bool("auto", true, "auto-drive the protocol past round-01 (default; use --no-auto to disable)")
  1718		noAuto := fs.Bool("no-auto", false, "disable auto-drive: stop after round-01 and advance the protocol manually")
  1719		noImplement := fs.Bool("no-implement", false, "stop the auto-driver at FINAL.md (skip code-writing implementation/fix-up phases)")
  1720		maxDriverSteps := fs.Int("max-driver-steps", 0, "auto-drive loop ceiling: max progress steps before escalating (explicit 0 = unlimited; omit to use ~/.parley [defaults.loop])")
  1721		maxWallClock := fs.Duration("max-wall-clock", 0, "auto-drive loop ceiling: total wall-clock budget before escalating, e.g. 90m (explicit 0 = unlimited; omit to use ~/.parley [defaults.loop])")
  1722		noPreflight := fs.Bool("no-preflight", false, "skip the pre-idea readiness check (CI escape)")
  1723		noPing := fs.Bool("no-ping", false, "preflight presence-only: skip the hosted-PONG roster ping (faster; for CI)")
  1724		participantsFlag := fs.String("participants", "", "comma-separated agent IDs to run")
  1725		yes := fs.Bool("yes", false, "launch selected agents without interactive confirmation")
  1726		root := fs.String("dir", ".", "workspace directory")
  1727		if err := fs.Parse(args); err != nil {
  1728			return 2
  1729		}
  1730		// Auto-drive is on by default; --no-auto is the explicit opt-out.
  1731		if *noAuto {
  1732			*auto = false
  1733		}
  1734		task := strings.TrimSpace(strings.Join(fs.Args(), " "))
  1735		if task == "" {
  1736			fmt.Fprintln(stderr, "usage: parley run [--no-tui] [--no-auto] [--participants AGENTS] [--yes] TASK")
  1737			return 2
  1738		}
  1739		// LE-5 loop ceilings: ~/.parley [defaults.loop] seeds them; an explicitly-passed
  1740		// run flag (even =0 for unlimited) overrides via flag.Visit (review fix F-T2-1).
  1741		lbSteps, lbWall, lbCost := loopBudget(*root)
  1742		fs.Visit(func(f *flag.Flag) {
  1743			switch f.Name {
  1744			case "max-driver-steps":
  1745				lbSteps = *maxDriverSteps
  1746			case "max-wall-clock":
  1747				lbWall = *maxWallClock
  1748			}
  1749		})
  1750	
  1751		workspaceStatus, err := protocol.ReadWorkspaceStatus(*root)
  1752		if err != nil {
  1753			if errors.Is(err, os.ErrNotExist) {
  1754				fmt.Fprintln(stderr, "no parley-deck workspace found; run `parley init` first")
  1755				return 1
  1756			}
  1757			fmt.Fprintf(stderr, "workspace read failed: %v\n", err)
  1758			return 1
  1759		}
  1760	
  1761		discovered, err := discoverConfigured(ctx, *root)
  1762		if err != nil {
  1763			fmt.Fprintf(stderr, "agent config failed: %v\n", err)
  1764			return 1
  1765		}
  1766		fmt.Fprintln(stdout, "Resolved agent runtime:")
  1767		agents.PrintRuntimeMatrix(stdout, discovered)
  1768		participants, err := selectedParticipantIDs(discovered, *participantsFlag)
  1769		if err != nil {
  1770			fmt.Fprintf(stderr, "participant selection failed: %v\n", err)
  1771			return 1
  1772		}
  1773		if len(participants) == 0 {
  1774			fmt.Fprintln(stderr, "no installed agents found; run `parley agents list` to inspect configuration")
  1775			return 1
  1776		}
  1777		// Pre-idea readiness check (preflight §9.0): runs AFTER discovery and BEFORE
  1778		// runcontrol.Create so a pending gate stops here with no half-open idea. It
  1779		// evaluates the EXACT selected participant set (so --participants cannot bypass
  1780		// the §1 non-solo hard-stop). Unattended (--auto, no TTY) hard-stops on a gate
  1781		// and never reads stdin; attended prints the gate + confirm command and stops.
  1782		// --no-preflight is the CI escape. Confirmed (--yes) exclusions are recorded in
  1783		// the created idea.
  1784		var preflightExcluded []string
  1785		if !*noPreflight {
  1786			code, excluded, stop := runTaskPreflight(ctx, *root, discovered, participants, attendedRun(*auto, *yes), *noPing, *yes, stdout, stderr)
  1787			if stop {
  1788				return code
  1789			}
  1790			preflightExcluded = excluded
  1791		}
  1792		if !*auto && !*yes && !confirmLaunch(os.Stdin, stdout, participants) {
  1793			fmt.Fprintln(stdout, "No run started. Use `--yes` or `--auto` to launch without an interactive confirmation prompt.")
  1794			return 0
  1795		}
  1796		created, err := runcontrol.Create(runcontrol.CreateOptions{
  1797			Root:         *root,
  1798			Task:         task,
  1799			Participants: participants,
  1800			Excluded:     preflightExcluded,
  1801			Discovered:   discovered,
  1802			Auto:         *auto,
  1803		})
  1804		if err != nil {
  1805			fmt.Fprintf(stderr, "run create failed: %v\n", err)
  1806			return 1
  1807		}
  1808	
  1809		fmt.Fprintf(stdout, "Created idea %s and run %s\n", created.Idea.Slug, created.RunID)
  1810		fmt.Fprintf(stdout, "Starting round-01 with participants: %s\n", strings.Join(participants, ", "))
  1811		runOpts := created.RunOptions
  1812		if *noTUI {
  1813			runCtx, cancelRun := context.WithCancel(ctx)
  1814			defer cancelRun()
  1815			if *auto {
  1816				runcontrol.StartAutoAnswerer(runCtx, created.RunDir)
  1817			}
  1818			results := runner.RunRoundOne(runCtx, runOpts)
  1819			failed := printRunResults(stdout, results)
  1820			if run, err := runstate.LoadRun(*root, created.RunID); err == nil {
  1821				registerWorkspaceSessions(*root, []runstate.RunSummary{run})
  1822			}
  1823			// Auto-advance past round-01 under --auto (any transport as of 1.27.0;
  1824			// the driver advances canonical artifacts, not PR/MR branches). Round-01
  1825			// must have succeeded. --no-auto keeps the one-shot behavior.
  1826			if *auto && !failed {
  1827				d := driver.New(driver.Config{
  1828					IdeaDir:           created.Idea.Path,
  1829					IdeaSlug:          created.Idea.Slug,
  1830					Participants:      created.Idea.Participants,
  1831					RunDir:            created.RunDir,
  1832					Root:              *root,
  1833					Events:            runOpts.Store,
  1834					CrossReviewRounds: driver.ReadCrossReviewRounds(created.Idea.Path),
  1835					Auto:              *auto,
  1836					Consensus:         newDriverConsensusOps(*root, created.Idea.Slug, created.Idea.Path, created.Idea.Participants, discovered, stdout),
  1837					Impl:              newDriverImplOps(runOpts, *root, created.Idea.Slug, created.Idea.Path, created.Idea.Participants, stdout),
  1838					AutoImplement:     driver.ReadAutoImplement(created.Idea.Path) && !*noImplement,
  1839					StrictGate:        driver.ReadStrictGate(created.Idea.Path),
  1840					MaxDriverSteps:    lbSteps,
  1841					MaxWallClock:      lbWall,
  1842					MaxCostUSD:        lbCost,
  1843					Out:               stdout,
  1844				}, driver.NewRunnerAdapter(runOpts))
  1845				if err := d.Run(runCtx); err != nil {
  1846					fmt.Fprintf(stderr, "driver: %v\n", err)
  1847				}
  1848				if run, err := runstate.LoadRun(*root, created.RunID); err == nil {
  1849					registerWorkspaceSessions(*root, []runstate.RunSummary{run})
  1850				}
  1851			}
  1852			cancelRun()
  1853			if failed {
  1854				return 1
  1855			}
  1856			return 0
  1857		}
  1858	
  1859		runCtx, cancelRun := context.WithCancel(ctx)
  1860		defer cancelRun()
  1861		handle := runner.RunRoundOneAsync(runCtx, runOpts)
  1862		// startAutoDrive advances the protocol past round-01 while the live TUI shows
  1863		// it (cross-review → consensus → finalize → opted-in implementation). It is
  1864		// idempotent (sync.Once): the auto default calls it now; the `/run` command
  1865		// lets a --no-auto run kick it on demand. The driver emits run.phase/agent
  1866		// events the TUI renders; its output is io.Discard so it never corrupts the
  1867		// render, and quitting the TUI cancels runCtx, which stops the driver.
  1868		var driveOnce sync.Once
  1869		startAutoDrive := func() {
  1870			driveOnce.Do(func() {
  1871				runcontrol.StartAutoAnswerer(runCtx, created.RunDir)
  1872				go func() {
  1873					select {
  1874					case <-runCtx.Done():
  1875						return
  1876					case <-handle.Done():
  1877					}
  1878					if anyRunFailed(handle.Results()) {
  1879						return
  1880					}
  1881					d := driver.New(driver.Config{
  1882						IdeaDir:           created.Idea.Path,
  1883						IdeaSlug:          created.Idea.Slug,
  1884						Participants:      created.Idea.Participants,
  1885						RunDir:            created.RunDir,
  1886						Root:              *root,
  1887						Events:            runOpts.Store,
  1888						CrossReviewRounds: driver.ReadCrossReviewRounds(created.Idea.Path),
  1889						Auto:              true,
  1890						Consensus:         newDriverConsensusOps(*root, created.Idea.Slug, created.Idea.Path, created.Idea.Participants, discovered, io.Discard),
  1891						Impl:              newDriverImplOps(runOpts, *root, created.Idea.Slug, created.Idea.Path, created.Idea.Participants, io.Discard),
  1892						AutoImplement:     driver.ReadAutoImplement(created.Idea.Path) && !*noImplement,
  1893						StrictGate:        driver.ReadStrictGate(created.Idea.Path),
  1894						MaxDriverSteps:    lbSteps,
  1895						MaxWallClock:      lbWall,
  1896						MaxCostUSD:        lbCost,
  1897						Out:               io.Discard,
  1898					}, driver.NewRunnerAdapter(runOpts))
  1899					if err := d.Run(runCtx); err != nil {
  1900						_ = runOpts.Store.Append(store.Event{Time: time.Now().UTC(), Type: "driver.error", Data: map[string]any{"error": err.Error()}})
  1901					}
  1902					if run, err := runstate.LoadRun(*root, created.RunID); err == nil {
  1903						registerWorkspaceSessions(*root, []runstate.RunSummary{run})
  1904					}
  1905				}()
  1906			})
  1907		}
  1908		if *auto {
  1909			startAutoDrive()
  1910		}
  1911		workspaceStatus.Ideas = []protocol.IdeaStatus{created.Idea}
  1912		steerFn, killFn, livenessFn := liveSteerKillSeams(runCtx, handle)
  1913		if err := tui.RunLive(tui.LiveOptions{
  1914			Status:           workspaceStatus,
  1915			Idea:             created.Idea,
  1916			Participants:     participants,
  1917			RunID:            created.RunID,
  1918			RunDir:           handle.RunDir,
  1919			Done:             handle.Done(),
  1920			Cancel:           cancelRun,
  1921			SubmitSteer:      steerFn,
  1922			KillAgent:        killFn,
  1923			Liveness:         livenessFn,
  1924			ReattachKill:     func(runID string) tui.KillAgentFunc { k, _ := reattachSeams(runDirFor(*root, runID)); return k },
  1925			ReattachLiveness: func(runID string) tui.LivenessFunc { _, l := reattachSeams(runDirFor(*root, runID)); return l },
  1926			StartAutoDrive:   startAutoDrive,
  1927			Root:             *root,
  1928			// `parley run` watches one run; start new ideas from `parley tui` (N).
  1929		}); err != nil {
  1930			cancelRun()
  1931			results := handle.Wait()
  1932			printRunResults(stdout, results)
  1933			fmt.Fprintf(stderr, "tui failed: %v\n", err)
  1934			return 1
  1935		}
  1936		results := handle.Wait()
  1937		if run, err := runstate.LoadRun(*root, created.RunID); err == nil {
  1938			registerWorkspaceSessions(*root, []runstate.RunSummary{run})
  1939		}
  1940		failed := printRunResults(stdout, results)
  1941		if failed {
  1942			return 1
  1943		}
  1944		return 0
  1945	}
  1946	
  1947	func runAnswer(args []string, stdout, stderr io.Writer) int {
  1948		fs := flag.NewFlagSet("answer", flag.ContinueOnError)
  1949		fs.SetOutput(stderr)
  1950		root := fs.String("dir", ".", "workspace directory")
  1951		if err := fs.Parse(args); err != nil {
  1952			return 2
  1953		}
  1954		rest := fs.Args()
  1955		if len(rest) < 3 {
  1956			fmt.Fprintln(stderr, "usage: parley answer [--dir DIR] RUN_ID QUESTION_ID ANSWER...")
  1957			return 2
  1958		}
  1959	
  1960		runID := rest[0]
  1961		questionID := rest[1]
  1962		answer := strings.TrimSpace(strings.Join(rest[2:], " "))
  1963		runDir := handleRunDir(*root, runID)
  1964		question, err := hitl.New(runDir).Answer(questionID, answer, false)
  1965		if err != nil {
  1966			fmt.Fprintf(stderr, "answer failed: %v\n", err)
  1967			return 1
  1968		}
  1969	
  1970		fmt.Fprintf(stdout, "Answered %s for run %s\n", question.ID, runID)
  1971		return 0
  1972	}
  1973	
  1974	func runTUI(ctx context.Context, args []string, stdout, stderr io.Writer) int {
  1975		fs := flag.NewFlagSet("tui", flag.ContinueOnError)
  1976		fs.SetOutput(stderr)
  1977		root := fs.String("dir", ".", "workspace directory")
  1978		if err := fs.Parse(args); err != nil {
  1979			return 2
  1980		}
  1981		return runTUIView(ctx, *root, stdout, stderr)
  1982	}
