  2336	func installedAgentIDs(discovered []agents.Discovery) []string {
  2337		ids := make([]string, 0, len(discovered))
  2338		for _, result := range discovered {
  2339			if result.Found && result.ID != "gemini" {
  2340				ids = append(ids, result.ID)
  2341			}
  2342		}
  2343		return ids
  2344	}
  2345	
  2346	func selectedParticipantIDs(discovered []agents.Discovery, raw string) ([]string, error) {
  2347		if strings.TrimSpace(raw) == "" {
  2348			return installedAgentIDs(discovered), nil
  2349		}
  2350	
  2351		installed := map[string]bool{}
  2352		for _, result := range discovered {
  2353			if result.Found {
  2354				installed[result.ID] = true
  2355			}
  2356		}
  2357	
  2358		var selected []string
  2359		seen := map[string]bool{}
  2360		for _, part := range strings.Split(raw, ",") {
  2361			id := strings.TrimSpace(part)
  2362			if id == "" || seen[id] {
  2363				continue
  2364			}
  2365			if !installed[id] {
  2366				return nil, fmt.Errorf("%s is not an installed agent", id)
  2367			}
  2368			selected = append(selected, id)
  2369			seen[id] = true
  2370		}
  2371		return selected, nil
  2372	}
