    29	// Phase is the deliberation phase the cursor currently rests in.
    30	type Phase string
    31	
    32	const (
    33		PhaseRound     Phase = "round"
    34		PhaseConsensus Phase = "consensus"
    35		PhaseFinal     Phase = "final"
    36		PhaseImpl      Phase = "impl"
    37		PhaseReview    Phase = "review"
    38		PhaseDone      Phase = "done"
    39		PhaseBlocked   Phase = "blocked"
    40	)
    41	
    42	// Cursor is a rebuildable cache of the deliberation phase. Disk is authoritative:
    43	// Rebuild derives every field from on-disk artifacts and the persisted Phase is
    44	// never trusted over disk. Only MaxRounds is config-derived.
    45	type Cursor struct {
    46		Phase        Phase  `json:"phase"`
    47		CurrentRound int    `json:"current_round"`
    48		IdeaStatus   string `json:"idea_status"`
    49		RoundsRun    int    `json:"rounds_run"`
    50		MaxRounds    int    `json:"max_rounds"`
    51		UpdatedAt    string `json:"updated_at"`
    52	}
    53	
    54	// Save writes the cursor atomically (tmp + rename, same dir) so a crash mid-write
    55	// cannot corrupt the durable state. Mirrors internal/pipeline/run.go Save.
    56	func (c Cursor) Save(path string) error {
    57		if err := fsutil.MkdirAllResilient(filepath.Dir(path), 0o755); err != nil {
    58			return fmt.Errorf("create driver dir: %w", err)
    59		}
    60		data, err := json.MarshalIndent(c, "", "  ")
    61		if err != nil {
    62			return fmt.Errorf("encode cursor: %w", err)
    63		}
    64		data = append(data, '\n')
    65		tmp := path + ".tmp"
    66		if err := os.WriteFile(tmp, data, 0o644); err != nil {
    67			return fmt.Errorf("write cursor: %w", err)
    68		}
    69		if err := os.Rename(tmp, path); err != nil {
    70			return fmt.Errorf("commit cursor: %w", err)
    71		}
    72		return nil
    73	}
    74	
    75	// LoadCursor best-effort reads a persisted cursor. A missing or corrupt file is
    76	// non-fatal: callers Rebuild from disk, which is authoritative.
    77	func LoadCursor(path string) (Cursor, error) {
    78		data, err := os.ReadFile(path)
    79		if err != nil {
    80			return Cursor{}, err
    81		}
    82		var c Cursor
    83		if err := json.Unmarshal(data, &c); err != nil {
    84			return Cursor{}, err
    85		}
    86		return c, nil
    87	}
    88	
    89	// Rebuild derives the phase purely from disk (consensus D2/D3). ideaDir is the
    90	// idea directory (…/ideas/<slug>). maxRounds is the config circuit-breaker bound.
    91	func Rebuild(ideaDir string, maxRounds int) Cursor {
    92		detail, _ := RebuildDetail(ideaDir, maxRounds)
    93		return detail.Cursor
    94	}
    95	
    96	// PhaseDetail augments the rebuilt Cursor with the display-only disk evidence a
    97	// consumer needs to disambiguate the review steps (6 review vs 7 review-consensus
    98	// vs 8 fix-up/complete) without re-probing the idea dir
    99	// (consensus tui-protocol-visibility D2). It is derived, never persisted.
   100	type PhaseDetail struct {
   101		Cursor                Cursor
   102		HighestReviewRound    int
   103		ReviewConsensusExists bool
   104		ImplementationStatus  string
   105		FinalScaffoldReason   string // "" when FINAL.md is absent or acceptable
   106	}
   107	
   108	// RebuildDetail derives the cursor and its display evidence in one disk pass.
   109	// Missing artifacts are normal zero values; an unreadable idea/review directory
   110	// or an unexpected stat/read error returns the partial detail with a non-nil
   111	// error so callers can keep their previous snapshot instead of trusting a
   112	// half-read state (consensus D2; review cycle-1 fix 1).
   113	func RebuildDetail(ideaDir string, maxRounds int) (PhaseDetail, error) {
   114		var firstErr error
   115		keepErr := func(err error) {
   116			if err != nil && firstErr == nil {
   117				firstErr = err
   118			}
   119		}
   120		c := Cursor{Phase: PhaseRound, CurrentRound: 1, MaxRounds: maxRounds}
   121		status, _, err := readFrontmatterFieldErr(filepath.Join(ideaDir, "00-prompt.md"), "status")
   122		keepErr(err)
   123		c.IdeaStatus = status
   124		highest, err := highestRoundErr(ideaDir)
   125		keepErr(err)
   126		if highest >= 1 {
   127			c.CurrentRound = highest
   128			c.RoundsRun = highest
   129		}
   130		finalPath := filepath.Join(ideaDir, "FINAL.md")
   131		implPath := filepath.Join(ideaDir, "IMPLEMENTATION.md")
   132		reviewConsensus := filepath.Join(ideaDir, "review", "consensus.md")
   133		var detail PhaseDetail
   134		reviewConsensusExists, err := statRegular(reviewConsensus)
   135		keepErr(err)
   136		detail.ReviewConsensusExists = reviewConsensusExists
   137		reviewRound, err := highestReviewRoundErr(ideaDir)
   138		keepErr(err)
   139		detail.HighestReviewRound = reviewRound
   140		implExists, err := statRegular(implPath)
   141		keepErr(err)
   142		if implExists {
   143			implStatus, _, err := readFrontmatterFieldErr(implPath, "status")
   144			keepErr(err)
   145			detail.ImplementationStatus = implStatus
   146		}
   147		finalExists, err := statRegular(finalPath)
   148		keepErr(err)
   149		if finalExists {
   150			detail.FinalScaffoldReason = finalScaffoldReason(finalPath)
   151			if detail.FinalScaffoldReason == "FINAL.md is missing" {
   152				// The stat saw the file but the read failed — surface it instead of
   153				// classifying the idea as pre-final.
   154				keepErr(fmt.Errorf("FINAL.md exists but could not be read"))
   155			}
   156		}
   157		consensusExists, err := statRegular(filepath.Join(ideaDir, "consensus.md"))
   158		keepErr(err)
   159		switch {
   160		// Most-terminal-first (D2): implementation/review artifacts win over FINAL/
   161		// consensus so a valid FINAL.md never hides later phases.
   162		case implExists && detail.ImplementationStatus == "complete":
   163			c.Phase = PhaseDone
   164		case detail.ReviewConsensusExists || detail.HighestReviewRound >= 1:
   165			c.Phase = PhaseReview
   166		case implExists:
   167			c.Phase = PhaseImpl
   168		case finalExists && detail.FinalScaffoldReason == "":
   169			// Only a VALID (non-scaffold) FINAL.md is truly final. A scaffold FINAL.md
   170			// from a failed/partial draft must NOT strand the idea at PhaseFinal — it
   171			// stays in the consensus phase so the gate re-drafts it (slice-2 AF1).
   172			c.Phase = PhaseFinal
   173		case consensusExists:
   174			c.Phase = PhaseConsensus
   175		case finalExists:
   176			// Scaffold FINAL.md with no consensus.md to re-drive: treat as final to
   177			// avoid a phantom round phase; the surface-only stop surfaces it to a human.
   178			c.Phase = PhaseFinal
   179		default:
   180			c.Phase = PhaseRound
   181		}
   182		c.UpdatedAt = time.Now().UTC().Format(time.RFC3339)
   183		detail.Cursor = c
   184		return detail, firstErr
   185	}
   186	
   187	// implementationStatus returns the status: frontmatter of an IMPLEMENTATION.md.
   188	func implementationStatus(implPath string) string {
   189		v, _ := readFrontmatterField(implPath, "status")
   190		return v
   191	}
   192	
   193	// highestReviewRound returns the largest N for which review/round-NN/ exists, or 0.
   194	func highestReviewRound(ideaDir string) int {
   195		n, _ := highestReviewRoundErr(ideaDir)
   196		return n
   197	}
   198	
   199	// highestReviewRoundErr is highestReviewRound, surfacing non-NotExist ReadDir
   200	// errors (a half-readable review dir must not silently read as "no rounds").
   201	func highestReviewRoundErr(ideaDir string) (int, error) {
   202		entries, err := os.ReadDir(filepath.Join(ideaDir, "review"))
   203		if err != nil {
   204			if errors.Is(err, fs.ErrNotExist) {
   205				return 0, nil
   206			}
   207			return 0, err
   208		}
   209		highest := 0
   210		for _, e := range entries {
   211			if e.IsDir() && strings.HasPrefix(e.Name(), "round-") {
   212				if n := roundOrdinal(e.Name()); n > highest {
   213					highest = n
   214				}
   215			}
   216		}
   217		return highest, nil
   218	}
   219	
   220	// highestRound returns the largest N for which a round-NN/ directory exists, or 0.
   221	func highestRound(ideaDir string) int {
   222		n, _ := highestRoundErr(ideaDir)
   223		return n
   224	}
   225	
   226	// highestRoundErr is highestRound, surfacing non-NotExist ReadDir errors.
   227	func highestRoundErr(ideaDir string) (int, error) {
   228		entries, err := os.ReadDir(ideaDir)
   229		if err != nil {
   230			if errors.Is(err, fs.ErrNotExist) {
   231				return 0, nil
   232			}
   233			return 0, err
   234		}
   235		highest := 0
   236		for _, e := range entries {
   237			if !e.IsDir() || !strings.HasPrefix(e.Name(), "round-") {
   238				continue
   239			}
   240			if n := roundOrdinal(e.Name()); n > highest {
   241				highest = n
   242			}
   243		}
   244		return highest, nil
   245	}
   246	
   247	// roundOrdinal parses "round-NN" → N, or 0 when the label is not a round dir.
   248	func roundOrdinal(label string) int {
   249		if !strings.HasPrefix(label, "round-") {
   250			return 0
   251		}
   252		n, err := strconv.Atoi(strings.TrimLeft(strings.TrimPrefix(label, "round-"), "0"))
   253		if err != nil {
   254			return 0
   255		}
   256		return n
   257	}
   258	
   259	func roundLabel(n int) string { return fmt.Sprintf("round-%02d", n) }
   260	
   261	func nowRFC3339() string { return time.Now().UTC().Format(time.RFC3339) }
   262	
   263	// readIdeaStatus reads the status: field from the idea 00-prompt.md frontmatter.
   264	func readIdeaStatus(ideaDir string) string {
   265		field, _ := readFrontmatterField(filepath.Join(ideaDir, "00-prompt.md"), "status")
   266		return field
   267	}
   268	
   269	// statRegular reports whether a regular file exists at path; a missing file is
   270	// (false, nil), any other stat error is surfaced (consensus D2).
   271	func statRegular(path string) (bool, error) {
   272		info, err := os.Stat(path)
   273		if err != nil {
   274			if errors.Is(err, fs.ErrNotExist) {
   275				return false, nil
   276			}
   277			return false, err
   278		}
   279		return info.Mode().IsRegular(), nil
   280	}
   281	
   282	// readFrontmatterField returns the trimmed value of a top-level frontmatter key.
   283	func readFrontmatterField(path, key string) (string, bool) {
   284		value, ok, _ := readFrontmatterFieldErr(path, key)
   285		return value, ok
   286	}
   287	
   288	// readFrontmatterFieldErr is readFrontmatterField with non-NotExist read errors
   289	// surfaced (a missing file stays a normal zero value).
   290	func readFrontmatterFieldErr(path, key string) (string, bool, error) {
   291		data, err := os.ReadFile(path)
   292		if err != nil {
   293			if errors.Is(err, fs.ErrNotExist) {
   294				return "", false, nil
   295			}
   296			return "", false, err
   297		}
   298		inFrontmatter := false
   299		prefix := key + ":"
   300		for _, line := range strings.Split(string(data), "\n") {
   301			trimmed := strings.TrimSpace(line)
   302			if trimmed == "---" {
   303				if !inFrontmatter {
   304					inFrontmatter = true
   305					continue
   306				}
   307				break
   308			}
   309			if inFrontmatter && strings.HasPrefix(trimmed, prefix) {
   310				return strings.TrimSpace(strings.TrimPrefix(trimmed, prefix)), true, nil
   311			}
   312		}
   313		return "", false, nil
   314	}
   315	
   316	func fileExists(path string) bool {
   317		info, err := os.Stat(path)
   318		return err == nil && info.Mode().IsRegular()
   319	}
   320	
   321	func dirExists(path string) bool {
   322		info, err := os.Stat(path)
   323		return err == nil && info.IsDir()
   324	}

