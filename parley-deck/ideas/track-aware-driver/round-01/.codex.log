  2316				WorkspaceRoot: root,
  2317				RunID:         run.RunID,
  2318				IdeaSlug:      run.IdeaSlug,
  2319				Task:          run.Task,
  2320				Participants:  append([]string(nil), run.Participants...),
  2321				CreatedAt:     createdAt,
  2322				UpdatedAt:     now,
  2323				LastEventAt:   run.LastEventAt,
  2324				Terminal:      run.Terminal,
  2325			})
  2326		}
  2327	}
