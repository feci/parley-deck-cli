   299	func (o driverImplOps) ReviewStatus() (driver.ReviewStatus, error) {
   300		summary, err := consensus.Status(o.root, o.ideaSlug, true)
   301		if err != nil {
   302			return driver.ReviewStatus{}, err
   303		}
   304		meta, err := protocol.ReadFrontmatter(filepath.Join(o.ideaDir, "review", "consensus.md"))
   305		if err != nil {
   306			return driver.ReviewStatus{}, err
   307		}
   308		rawFixes := strings.Trim(strings.TrimSpace(meta["outstanding_agreed_fixes"]), `"'`)
   309		fixes, err := strconv.Atoi(rawFixes)
   310		if err != nil || fixes < 0 {
   311			return driver.ReviewStatus{}, fmt.Errorf("review/consensus.md outstanding_agreed_fixes=%q is not a non-negative integer", rawFixes)
   312		}
   313		blocked := strings.EqualFold(strings.Trim(strings.TrimSpace(meta["blocked"]), `"'`), "true")
   314		// LE-2 strict_gate close fields (absent/zero on non-strict ideas → harmless defaults).
   315		strictClean := strings.EqualFold(strings.Trim(strings.TrimSpace(meta["strict_gate_clean"]), `"'`), "true")
   316		closingRound := 0
   317		if v := strings.Trim(strings.TrimSpace(meta["closing_review_round"]), `"'`); v != "" {
   318			if n, err := strconv.Atoi(v); err == nil && n >= 0 {
   319				closingRound = n
   320			}
   321		}
   322		return driver.ReviewStatus{
   323			Summary: summary, OutstandingAgreedFixes: fixes, Blocked: blocked,
   324			StrictGateClean: strictClean, ClosingReviewRound: closingRound,
   325			ReviewerCount: len(o.reviewers), // LE-11
   326		}, nil
   327	}
