   116			c.RoundsRun = next
   117			c.Phase = PhaseRound
   118			c.UpdatedAt = nowRFC3339()
   119			if err := d.commitCursor(c, ActionReopened, PhaseConsensus); err != nil {
   120				return ActionEscalated, c, err
   121			}
   122			return ActionReopened, c, nil
   123	
   124		default: // TriageMalformed or unknown
   125			return ActionEscalated, c, fmt.Errorf("consensus triage=%q; cannot auto-advance, escalating", summary.Triage)
   126		}
   127	}
   128	
   129	// invalidateStale renames a stale consensus.md / FINAL.md to *.bak after a BLOCK
   130	// reopen so Rebuild cannot misclassify the reopened round as already at consensus
   131	// or final (consensus D6). It removes a pre-existing *.bak first so the rename
   132	// works across BLOCK cycles and on Windows (where os.Rename fails if the
   133	// destination exists), and returns an error so the caller can halt rather than
   134	// silently leave a stale FINAL.md behind (AF4).
   135	func (d *Driver) invalidateStale() error {
   136		for _, name := range []string{"consensus.md", "FINAL.md"} {
   137			path := filepath.Join(d.cfg.IdeaDir, name)
   138			if !fileExists(path) {
   139				continue
   140			}
   141			bak := path + ".bak"
   142			if fileExists(bak) {
   143				if err := os.Remove(bak); err != nil {
   144					return err
   145				}
   146			}
   147			if err := os.Rename(path, bak); err != nil {
   148				return err
   149			}
   150		}
   151		return nil
   152	}
