+package pipeline
+
+import "testing"
+
+const dagYAML = `
+schema_version: 1
+idea_slug: dag-demo
+transport: local-dir
+execution: dag
+participants: [codex, claude]
+blocks:
+  - {id: spec, kind: deliberation}
