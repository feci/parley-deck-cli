+def _validate_explicit_table(tasks, roster, table):
+    """Validate a caller-supplied four-person table and return fresh result rows.
+
+    Pure validation: nothing is rebalanced, reseeded, or dropped. Any malformed
+    shape, unknown/duplicate/missing membership, forged index, mutated role, or
+    unbalanced schedule raises ValueError. Returned rows share no mutable state
+    with the caller's tasks, roster, or table.
+    """
+    if (not isinstance(roster, (list, tuple)) or len(roster) != 4 or
+            any(not isinstance(person, str) or not person for person in roster) or
+            len(set(roster)) != 4):
+        raise ValueError("An explicit table requires four distinct nonempty roster IDs")
+    if (not isinstance(tasks, (list, tuple)) or len(tasks) != 12 or
+            any(not isinstance(task, dict) or
+                not isinstance(task.get("id"), str) or not task["id"] or
+                not isinstance(task.get("category"), str) for task in tasks)):
+        raise ValueError("Explicit-table tasks require twelve records with nonempty IDs and categories")
+    if len({task["id"] for task in tasks}) != 12:
+        raise ValueError("Exactly twelve unique task IDs are required")
+    categories = Counter(task.get("category") for task in tasks)
+    if categories != Counter({"code": 4, "review": 4, "design": 4}):
+        raise ValueError("Explicit-table tasks must be exactly four each of code, review and design")
+    if isinstance(table, (str, bytes)) or not isinstance(table, (list, tuple)) or len(table) != 12:
+        raise ValueError("Explicit table must be a sequence of exactly twelve rows")
+    frozen = frozenset(roster)
+    category_by_id = {task["id"]: task.get("category") for task in tasks}
+    seen_tasks = set()
+    orders, positions = Counter(), Counter()
+    solo_counts, duo_roles, full_roles = Counter(), Counter(), Counter()
+    solo_categories = {person: [] for person in roster}
+    duo_pairs, full_pairs = Counter(), Counter()
+    rows = []
+    for position, row in enumerate(table):
+        if not isinstance(row, dict) or set(row) != {"task", "execution_index", "arms"}:
+            raise ValueError("Malformed explicit-table row")
+        index = row["execution_index"]
+        if isinstance(index, bool) or not isinstance(index, int) or index != position:
+            raise ValueError("Execution indexes must be integers 0..11 matching list order")
+        task_id = row["task"]
+        if not isinstance(task_id, str) or task_id not in category_by_id or task_id in seen_tasks:
+            raise ValueError("Explicit table must name each provided task ID exactly once")
+        seen_tasks.add(task_id)
+        arms = row["arms"]
+        if not isinstance(arms, (list, tuple)) or len(arms) != 3:
+            raise ValueError("Each explicit-table row needs exactly three arm cells")
+        by_arm = {}
+        for cell in arms:
+            if not isinstance(cell, dict) or set(cell) != {"arm", "participants", "drafter", "critic"}:
+                raise ValueError("Malformed explicit-table arm cell")
+            arm = cell["arm"]
+            if arm not in ARMS or arm in by_arm:
+                raise ValueError("Each row needs exactly one solo, duo and full cell")
+            participants = cell["participants"]
+            if (not isinstance(participants, (list, tuple)) or
+                    any(not isinstance(person, str) or person not in frozen for person in participants)):
+                raise ValueError("Arm participants must be members of the frozen roster")
+            if len(set(participants)) != len(participants):
+                raise ValueError("Arm participants must be distinct")
+            expected = {"solo": 1, "duo": 2, "full": 4}[arm]
+            if len(participants) != expected:
+                raise ValueError("Arm membership must be one solo, two duo or four full participants")
+            if arm == "full" and frozenset(participants) != frozen:
+                raise ValueError("Every full cell must contain the whole frozen roster")
+            drafter, critic = cell["drafter"], cell["critic"]
+            if drafter not in participants or critic not in participants:
+                raise ValueError("Drafter and critic must be arm participants")
+            if arm == "solo":
+                if drafter != participants[0] or critic != participants[0]:
+                    raise ValueError("Solo drafter and critic must be the solo participant")
+            elif drafter == critic:
+                raise ValueError("Duo and full drafter and critic must differ")
+            by_arm[arm] = cell
+        solo_person = by_arm["solo"]["participants"][0]
+        solo_counts[solo_person] += 1
+        solo_categories[solo_person].append(category_by_id[task_id])
+        duo = by_arm["duo"]
+        duo_roles[("drafter", duo["drafter"])] += 1
+        duo_roles[("critic", duo["critic"])] += 1
+        duo_pairs[(duo["drafter"], duo["critic"])] += 1
+        full = by_arm["full"]
+        full_roles[("drafter", full["drafter"])] += 1
+        full_roles[("critic", full["critic"])] += 1
+        full_pairs[(full["drafter"], full["critic"])] += 1
+        order = tuple(cell["arm"] for cell in arms)
+        orders[order] += 1
+        positions.update((cell["arm"], slot) for slot, cell in enumerate(arms))
+        rows.append({"task": task_id, "execution_index": position,
