+    for first, second in itertools.permutations(roster, 2):
+        if full_pairs[(first, second)] != 1:
+            raise ValueError("Each ordered full drafter/critic-lead pair must occur exactly once")
+    if set(orders) != set(itertools.permutations(ARMS)) or any(count != 2 for count in orders.values()):
+        raise ValueError("Each arm ordering must occur exactly twice")
+    if any(positions[(arm, slot)] != 4 for arm in ARMS for slot in range(3)):
+        raise ValueError("Each arm must occupy each ordinal position exactly four times")
+    return rows
 
 
