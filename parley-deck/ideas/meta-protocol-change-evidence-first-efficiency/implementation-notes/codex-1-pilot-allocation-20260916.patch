+    ("R04", "claude-1", ("zcode-1", "kimi-1"), ("kimi-1", "codex-1"), ("full", "solo", "duo")),
+    ("D04", "codex-1", ("claude-1", "zcode-1"), ("zcode-1", "kimi-1"), ("full", "duo", "solo")),
+]
+
+
+def explicit_table():
+    table = []
+    for index, (task, solo, duo, full, order) in enumerate(CODEX_ROUND02_ROWS):
+        cells = {
+            "solo": {"arm": "solo", "participants": [solo], "drafter": solo, "critic": solo},
+            "duo": {"arm": "duo", "participants": list(duo), "drafter": duo[0], "critic": duo[1]},
